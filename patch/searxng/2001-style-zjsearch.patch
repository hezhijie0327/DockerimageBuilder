diff --git a/searx/templates/zjsearch/results.html b/searx/templates/zjsearch/results.html
new file mode 100644
index 0000000..d8cf358
--- /dev/null
+++ b/searx/templates/zjsearch/results.html
@@ -0,0 +1,15 @@
+{% extends "zjsearch/base.html" %}
+{% from "zjsearch/data/macros.html" import page_results with context %}
+{% block title %}{% if query_in_title %}{{- q|e }} - {% endif %}{% endblock %}
+{% block head %}<link rel="alternate" type="application/rss+xml" title="{{ instance_name }} search: {{ q|e }}" href="{{ url_for('search', _external=True) }}?q={{ q|urlencode }}&amp;categories={{ selected_categories|join(",") | replace(' ','+') }}&amp;pageno={{ pageno }}&amp;time_range={{ time_range }}&amp;language={{ current_language }}&amp;safesearch={{ safesearch }}&amp;format=rss">{% endblock %}
+{% block page_data -%}
+{%- if results and results|map(attribute='template')|unique|list|count == 1 -%}
+  {%- set only_template = results[0]['template']|default('default.html')|replace('.html', '') -%}
+{%- else -%}
+  {%- set only_template = '' -%}
+{%- endif -%}
+{{- page_results(results, q, selected_categories, pageno, time_range, suggestions,
+                 corrections, answers, infoboxes, engine_data, paging,
+                 unresponsive_engines, timings, max_response_time,
+                 timeout_limit, current_language, search_language, only_template) -}}
+{%- endblock %}
diff --git a/searx/templates/zjsearch/rss.xsl b/searx/templates/zjsearch/rss.xsl
new file mode 100644
index 0000000..5b84943
--- /dev/null
+++ b/searx/templates/zjsearch/rss.xsl
@@ -0,0 +1,44 @@
+<?xml version="1.0"?>
+<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
+  <xsl:output method="html" version="5" encoding="UTF-8" indent="yes" />
+  <xsl:template match="rss">
+    <html xmlns="http://www.w3.org/1999/xhtml">
+      <head>
+        <title><xsl:value-of select="channel/title" />RSS Feed</title>
+        <meta charset="UTF-8" />
+        <meta name="viewport" content="width=device-width,initial-scale=1" />
+        <style>
+          body { font-family: system-ui, sans-serif; margin: 0 auto; max-width: 48rem; padding: 0 1rem; color: #1a1a1e; background: #f7f7f8; }
+          a { color: #5457d6; }
+          hr { border: none; border-top: 1px solid #e5e5ea; }
+          time { color: #6b6b76; font-size: 0.85rem; }
+        </style>
+      </head>
+      <body>
+        <header>
+          <h2>
+            <xsl:value-of select="channel/description" />
+          </h2>
+        </header>
+        <hr />
+        <main>
+          <xsl:for-each select="channel/item">
+            <article>
+              <h3>
+                <a hreflang="en" target="_blank">
+                  <xsl:attribute name="href">
+                    <xsl:value-of select="link" />
+                  </xsl:attribute>
+                  <xsl:value-of select="title" />
+                </a>
+              </h3>
+              <time><xsl:value-of select="pubDate" /></time>
+              <p><xsl:value-of select="description" /></p>
+              <hr />
+            </article>
+          </xsl:for-each>
+        </main>
+      </body>
+    </html>
+  </xsl:template>
+</xsl:stylesheet>
