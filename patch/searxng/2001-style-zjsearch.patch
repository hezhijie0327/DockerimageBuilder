+}
+
+// ------------------------------------------------------------------ results
+
+export interface ResultItem {
+  template: string;
+  url: string;
+  title_html: string;
+  title_text: string;
+  content_html: string;
+  content_text: string;
+  engines: string[];
+  category: string;
+  priority: string;
+
+  netloc?: string;
+  favicon?: string;
+  pretty_url?: string[];
+  published_date?: string;
