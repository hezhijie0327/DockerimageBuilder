+    return (
+      <div className="rounded-2xl border border-line bg-surface p-4 text-sm text-ink-2">
+        <p className="flex items-center gap-2">
+          <Info className="size-4 shrink-0 text-accent" />
+          {t("no_web_results")}
+        </p>
+      </div>
