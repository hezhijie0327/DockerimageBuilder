@@ -0,0 +1,423 @@
+/* SPDX-License-Identifier: Apache-2.0 WITH Commons-Clause-1.0 */
+
+/* zjsearch design system: minimal, modern, light & dark. */
+
+@import "tailwindcss";
+
+@custom-variant dark (&:where(.dark, .dark *));
+
+/* Kagi-inspired warm palette: warm neutrals + amber accent. */
+:root {
+  --bg: #faf9f6;
+  --surface: #ffffff;
+  --surface-2: #f1efe8;
+  --line: #e6e2d7;
+  --ink: #201d17;
+  --ink-2: #6b675c;
+  /* muted tier: must keep 4.5:1 against every surface it sits on (worst case
+     surface-2 #f1efe8) */
+  --ink-3: #716c61;
+  --accent: #a67c00;
+  --accent-hover: #8c6800;
+  --accent-strong: #f5c84c;
+  --accent-strong-hover: #eebd35;
+  --accent-soft: #faf0cf;
+  --accent-contrast: #241d0e;
+  --highlight-bg: #fde68a;
+  --danger: #dc2626;
+  --warning: #b45309;
+  --ok: #15803d;
+  --shadow-card: 0 1px 2px rgb(32 29 23 / 0.05), 0 4px 16px rgb(32 29 23 / 0.05);
+  --shadow-pop: 0 4px 6px rgb(32 29 23 / 0.07), 0 12px 32px rgb(32 29 23 / 0.16);
+  color-scheme: light;
+}
+
+.dark {
+  --bg: #1b1a18;
+  --surface: #232120;
+  --surface-2: #2c2a27;
+  --line: #38342f;
+  --ink: #eceae4;
+  --ink-2: #a8a399;
+  --ink-3: #9b958a;
+  --accent: #fec843;
+  --accent-hover: #ffd76b;
+  --accent-strong: #fec843;
+  --accent-strong-hover: #ffd76b;
+  --accent-soft: #3a3320;
+  --accent-contrast: #241d0e;
+  --highlight-bg: #4a4020;
+  --danger: #f87171;
+  --warning: #fbbf24;
+  --ok: #4ade80;
+  --shadow-card: 0 1px 2px rgb(0 0 0 / 0.35), 0 4px 16px rgb(0 0 0 / 0.3);
+  --shadow-pop: 0 4px 6px rgb(0 0 0 / 0.45), 0 12px 32px rgb(0 0 0 / 0.55);
+  color-scheme: dark;
+}
+
+/* Black (OLED): even deeper surfaces, applied on top of .dark */
+.black {
+  --bg: #000000;
+  --surface: #0b0b0c;
+  --surface-2: #161617;
+  --line: #242426;
+  --ink: #ececec;
+  --ink-2: #9a9a9a;
+  --ink-3: #828282;
+  --accent-soft: #292413;
+  --highlight-bg: #3d3617;
+  --shadow-card: 0 1px 2px rgb(0 0 0 / 0.6), 0 4px 16px rgb(0 0 0 / 0.5);
+}
+
+@theme inline {
+  --color-bg: var(--bg);
+  --color-surface: var(--surface);
+  --color-surface-2: var(--surface-2);
+  --color-line: var(--line);
+  --color-ink: var(--ink);
+  --color-ink-2: var(--ink-2);
+  --color-ink-3: var(--ink-3);
+  --color-accent: var(--accent);
+  --color-accent-hover: var(--accent-hover);
+  --color-accent-strong: var(--accent-strong);
+  --color-accent-strong-hover: var(--accent-strong-hover);
+  --color-accent-soft: var(--accent-soft);
+  --color-accent-contrast: var(--accent-contrast);
+  --color-highlight: var(--highlight-bg);
+  --color-danger: var(--danger);
+  --color-warning: var(--warning);
+  --color-ok: var(--ok);
+
+  --shadow-card: var(--shadow-card);
+  --shadow-pop: var(--shadow-pop);
+
+  --font-sans:
+    ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "PingFang SC",
+    "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
+  --font-mono: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, monospace;
+
+  --animate-fade-up: fade-up 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
+  --animate-slide-in-right: slide-in-right 0.32s cubic-bezier(0.22, 1, 0.36, 1) both;
+  --animate-fade-in: fade-in 0.2s ease-out both;
+  --animate-shimmer: shimmer 1.6s linear infinite;
+  --animate-progress: progress 1.1s cubic-bezier(0.65, 0.05, 0.36, 1) infinite;
+  --animate-pulse-soft: pulse-soft 1.6s ease-in-out infinite;
+  --animate-spin-slow: spin 1.6s linear infinite;
+}
+
+@keyframes slide-in-right {
+  from {
+    transform: translateX(100%);
+  }
+  to {
+    transform: translateX(0);
+  }
+}
+
+@keyframes fade-up {
+  from {
+    opacity: 0;
+    transform: translateY(8px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+@keyframes fade-in {
+  from {
+    opacity: 0;
+  }
+  to {
+    opacity: 1;
+  }
+}
+
+@keyframes shimmer {
+  from {
+    transform: translateX(-100%);
+  }
+  to {
+    transform: translateX(100%);
+  }
+}
+
+@keyframes progress {
+  0% {
+    transform: translateX(-100%) scaleX(0.4);
+  }
+  50% {
+    transform: translateX(30vw) scaleX(0.6);
+  }
+  100% {
+    transform: translateX(100vw) scaleX(0.4);
+  }
+}
+
+@keyframes pulse-soft {
+  0%,
+  100% {
+    opacity: 1;
+    transform: scale(1);
+  }
+  50% {
+    opacity: 0.55;
+    transform: scale(0.94);
+  }
+}
+
+@layer base {
+  html {
+    height: 100%;
+  }
+
+  body {
+    min-height: 100%;
+    background: var(--bg);
+    color: var(--ink);
+    font-family: var(--font-sans);
+    -webkit-font-smoothing: antialiased;
+    text-rendering: optimizeLegibility;
+  }
+
+  ::selection {
+    background: color-mix(in oklab, var(--accent) 26%, transparent);
+  }
+
+  :focus-visible {
+    outline: 2px solid var(--accent);
+    outline-offset: 2px;
+    border-radius: 4px;
+  }
+
+  button,
+  input,
+  select {
+    font: inherit;
+    color: inherit;
+  }
+
+  /* Tailwind v4 preflight no longer gives buttons the pointer cursor */
+  button {
+    cursor: pointer;
+  }
+
+  button:disabled {
+    cursor: default;
+  }
+}
+
+@layer components {
+  /* query highlight spans inserted by the server side highlighter */
+  .highlight {
+    background: var(--highlight-bg);
+    color: var(--ink);
+    border-radius: 3px;
+    padding: 0 1px;
+    box-decoration-break: clone;
+  }
+
+  .zjs-noscript {
+    max-width: 40rem;
+    margin: 20vh auto 0;
+    padding: 0 1.25rem;
+    font-family: var(--font-sans);
+    line-height: 1.6;
+  }
+
+  .zjs-noscript a {
+    color: var(--accent);
+  }
+
+  .zjs-skeleton {
+    position: relative;
+    overflow: hidden;
+    background: var(--surface-2);
+    border-radius: 8px;
+  }
+
+  .zjs-skeleton::after {
+    content: "";
+    position: absolute;
+    inset: 0;
+    background: linear-gradient(90deg, transparent, color-mix(in oklab, var(--surface) 65%, transparent), transparent);
+    animation: var(--animate-shimmer);
+  }
+
+  /* server-rendered info/about pages (markdown-generated HTML) */
+  .prose-basic {
+    line-height: 1.7;
+    font-size: 0.925rem;
+    color: var(--ink-2);
+  }
+
+  .prose-basic h1,
+  .prose-basic h2,
+  .prose-basic h3 {
+    color: var(--ink);
+    font-weight: 600;
+    margin: 1.6em 0 0.5em;
+    line-height: 1.3;
+  }
+
+  .prose-basic h1 {
+    font-size: 1.5rem;
+    margin-top: 0.2em;
+  }
+
+  .prose-basic h2 {
+    font-size: 1.2rem;
+  }
+
+  .prose-basic a {
+    color: var(--accent);
+    text-decoration: underline;
+    text-underline-offset: 2px;
+  }
+
+  .prose-basic ul,
+  .prose-basic ol {
+    margin: 0.8em 0;
+    padding-inline-start: 1.4em;
+    list-style: disc;
+  }
+
+  .prose-basic ol {
+    list-style: decimal;
+  }
+
+  .prose-basic li {
+    margin: 0.25em 0;
+  }
+
+  .prose-basic code {
+    font-family: var(--font-mono);
+    font-size: 0.85em;
+    background: var(--surface-2);
+    border-radius: 4px;
+    padding: 0.1em 0.35em;
+  }
+
+  .prose-basic pre {
+    background: var(--surface-2);
+    border: 1px solid var(--line);
+    border-radius: 12px;
+    padding: 0.9em 1.1em;
+    overflow-x: auto;
+    margin: 1em 0;
+  }
+
+  .prose-basic pre code {
+    background: none;
+    padding: 0;
+  }
+
+  .prose-basic table {
+    border-collapse: collapse;
+    margin: 1em 0;
+    width: 100%;
+  }
+
+  .prose-basic th,
+  .prose-basic td {
+    border: 1px solid var(--line);
+    padding: 0.4em 0.7em;
+    text-align: start;
+  }
+
+  .prose-basic th {
+    background: var(--surface-2);
+    color: var(--ink);
+  }
+
+  .prose-basic blockquote {
+    border-inline-start: 3px solid var(--accent);
+    padding-inline-start: 1em;
+    margin: 1em 0;
+    color: var(--ink-3);
+  }
+
+  .prose-basic hr {
+    border: none;
+    border-top: 1px solid var(--line);
+    margin: 2em 0;
+  }
+
+  .prose-basic img {
+    max-width: 100%;
+    border-radius: 8px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+    scroll-behavior: auto !important;
+  }
+}
+
+/* results width: wide by default (capped for readability), narrow + centered
+   when the center_alignment preference is on */
+.zjs-results-main,
+.zjs-results-header-row {
+  max-width: var(--results-max, 90rem);
+}
+
+html.centered {
+  --results-max: 72rem;
+}
+
+/* hero shell (home page) owns its scrolling: the document never scrolls or
+   rubber-bands (iOS Safari would otherwise push the whole layout around);
+   all overflow lives in the shell's inner scroll container */
+.zjs-hero-lock {
+  overflow: hidden;
+  overscroll-behavior: none;
+}
+
+/* OpenLayers map chrome: zoom control themed to the dark map buttons */
+.zjs-map .ol-zoom {
+  top: 0.625rem;
+  left: 0.625rem;
+}
+.zjs-map .ol-zoom button {
+  width: 1.75rem;
+  height: 1.75rem;
+  font-size: 1.125rem;
+  font-weight: 600;
+  line-height: 1;
+  color: #fff;
+  background-color: rgb(0 0 0 / 0.7);
+  border: none;
+  border-radius: 0;
+  cursor: pointer;
+}
+.zjs-map .ol-zoom button:hover,
+.zjs-map .ol-zoom button:focus,
+.zjs-map .ol-zoom button:active {
+  background-color: rgb(0 0 0 / 0.85);
+  color: #fff;
+}
+.zjs-map .ol-zoom .ol-zoom-in {
+  border-radius: 0.5rem 0.5rem 0 0;
+}
+.zjs-map .ol-zoom .ol-zoom-out {
+  border-radius: 0 0 0.5rem 0.5rem;
+  border-top: 1px solid rgb(255 255 255 / 0.25);
+}
+
+.zjs-map .ol-scale-line {
+  background: rgb(0 0 0 / 0.7);
+  border-radius: 0.5rem;
+  padding: 2px 6px;
+}
+.zjs-map .ol-scale-line-inner {
+  margin: 1px 0;
+  color: #fff;
+  border-color: #fff;
+}
