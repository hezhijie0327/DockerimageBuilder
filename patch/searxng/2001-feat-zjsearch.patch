@@ -0,0 +1,163 @@
+// SPDX-License-Identifier: Apache-2.0 WITH Commons-Clause-1.0
+
+import { AlignCenterVertical, Globe, Languages, Link as LinkIcon, Monitor, Moon, Sun, Tag } from "lucide-react";
+import { Fragment } from "react";
+import { cap } from "@/lib/format.ts";
+import { useT } from "@/lib/i18n.ts";
+import type { ThemeStyle } from "@/lib/theme.ts";
+import { applyCenterAlignment, applyThemeStyle } from "@/lib/theme.ts";
+import type { PreferencesPageData } from "@/lib/types.ts";
+import { Card, SectionLabel, Select, SettingRow, Switch } from "@/pages/preferences/parts.tsx";
+import type { PreferencesForm } from "@/pages/preferences/usePreferencesForm.ts";
+
+export function UiTab({
+  data,
+  form,
+  locked,
+}: {
+  data: PreferencesPageData;
+  form: PreferencesForm;
+  locked: Set<string>;
+}) {
+  const t = useT();
+  const locales = Object.entries(data.locales).sort((a, b) => a[1].localeCompare(b[1]));
+  // grouped like the plugins tab; a group only renders while at least one of
+  // its rows survives the locked-preferences filter
+  const showLook =
+    !locked.has("locale") || !locked.has("theme") || !locked.has("simple_style") || !locked.has("center_alignment");
+  const showDisplay = !locked.has("favicon_resolver") || !locked.has("urlformatting") || !locked.has("query_in_title");
+  return (
+    <Card>
+      {showLook ? (
+        <Fragment>
+          <SectionLabel label={t("ui_group_look")} />
+          {!locked.has("locale") ? (
+            <SettingRow
+              description={t("change_layout_language")}
+              icon={<Languages className="size-4.5" />}
+              title={t("interface_language")}
+            >
+              <Select
+                ariaLabel={t("interface_language")}
+                onChange={form.setLocale}
+                options={locales.map(([id, name]) => ({ value: id, label: name }))}
+                value={form.locale}
+              />
+            </SettingRow>
+          ) : null}
+          {!locked.has("theme") ? (
+            <SettingRow description={t("change_layout")} icon={<Monitor className="size-4.5" />} title={t("theme")}>
+              <Select
+                ariaLabel={t("theme")}
+                onChange={form.setTheme}
+                options={data.themes.map((name) => ({
+                  value: name,
+                  label: name === "zjsearch" ? "ZJSearch" : cap(name),
+                }))}
+                value={form.theme}
+              />
+            </SettingRow>
+          ) : null}
+          {!locked.has("simple_style") ? (
+            <SettingRow description={t("choose_auto")} icon={<Sun className="size-4.5" />} title={t("theme_style")}>
+              <div className="inline-flex rounded-xl border border-line bg-surface p-0.5">
+                {(
+                  [
+                    ["auto", cap(t("auto")), <Sun className="size-3.5" key="a" />],
+                    ["light", cap(t("light")), <Sun className="size-3.5" key="l" />],
+                    ["dark", cap(t("dark")), <Moon className="size-3.5" key="d" />],
+                    ["black", cap(t("black")), <Moon className="size-3.5" key="b" />],
+                  ] as const
+                ).map(([value, label, icon]) => (
+                  <button
+                    aria-pressed={form.themeStyle === value}
+                    className={`inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-[13px] transition-colors ${
+                      form.themeStyle === value
+                        ? "bg-accent-strong font-medium text-accent-contrast"
+                        : "text-ink-2 hover:text-ink"
+                    }`}
+                    key={value}
+                    onClick={() => {
+                      form.setThemeStyle(value);
+                      applyThemeStyle(value as ThemeStyle);
+                    }}
+                    title={label}
+                    type="button"
+                  >
+                    {icon}
+                    <span className="hidden md:inline">{label}</span>
+                  </button>
+                ))}
+              </div>
+            </SettingRow>
+          ) : null}
+          {!locked.has("center_alignment") ? (
+            <SettingRow
+              description={t("center_alignment_desc")}
+              icon={<AlignCenterVertical className="size-4.5" />}
+              title={t("center_alignment")}
+            >
+              <Switch
+                checked={form.centerAlignment}
+                label={t("center_alignment")}
+                onChange={(value) => {
+                  form.setCenterAlignment(value);
+                  applyCenterAlignment(value);
+                }}
+              />
+            </SettingRow>
+          ) : null}
+        </Fragment>
+      ) : null}
+      {showDisplay ? (
+        <Fragment>
+          <SectionLabel label={t("ui_group_display")} />
+          {!locked.has("favicon_resolver") ? (
+            <SettingRow
+              description={t("display_favicons")}
+              icon={<Globe className="size-4.5" />}
+              title={t("favicon_resolver")}
+            >
+              <Select
+                ariaLabel={t("favicon_resolver")}
+                onChange={form.setFaviconResolver}
+                options={[
+                  { value: "", label: "-" },
+                  ...data.favicon_resolver_names.map((name) => ({ value: name, label: name })),
+                ]}
+                value={form.faviconResolver}
+              />
+            </SettingRow>
+          ) : null}
+          {!locked.has("urlformatting") ? (
+            <SettingRow
+              description={t("change_url_formatting")}
+              icon={<LinkIcon className="size-4.5" />}
+              title={t("url_formatting")}
+            >
+              <Select
+                ariaLabel={t("url_formatting")}
+                onChange={form.setUrlFormatting}
+                options={[
+                  { value: "pretty", label: t("pretty") },
+                  { value: "full", label: t("full") },
+                  { value: "host", label: t("host") },
+                ]}
+                value={form.urlFormatting}
+              />
+            </SettingRow>
+          ) : null}
+          {!locked.has("query_in_title") ? (
+            <SettingRow
+              description={t("query_in_title_desc")}
+              icon={<Tag className="size-4.5" />}
+              title={t("query_in_title")}
+            >
+              <Switch checked={form.queryInTitle} label={t("query_in_title")} onChange={form.setQueryInTitle} />
+            </SettingRow>
+          ) : null}
+        </Fragment>
+      ) : null}
+    </Card>
+  );
+}
diff --git a/client/zjsearch/src/pages/preferences/usePreferencesForm.ts b/client/zjsearch/src/pages/preferences/usePreferencesForm.ts
new file mode 100644
index 0000000..b717522
--- /dev/null
+++ b/client/zjsearch/src/pages/preferences/usePreferencesForm.ts
@@ -0,0 +1,225 @@
+// SPDX-License-Identifier: Apache-2.0 WITH Commons-Clause-1.0
+
+/**
+ * All preference form state plus the auto-save machinery.  Every change is
+ * debounced and POSTed with the exact form semantics of upstream
+ * /preferences (Preferences.parse_form): absent booleans are false, and the
+ * `engine_*` / `plugin_*` keys are REVERSED — a posted key marks that engine
+ * or plugin as disabled, so we send exactly the disabled set (omitted keys
+ * are re-enabled by the server).
+ */
+
+import { useEffect, useRef, useState } from "react";
+import { fetchText } from "@/lib/http.ts";
+import { useT } from "@/lib/i18n.ts";
+import { flashToast } from "@/lib/toast.ts";
+import type { PreferencesPageData } from "@/lib/types.ts";
+
+export function usePreferencesForm(data: PreferencesPageData) {
+  const kv = data.kv;
+  const t = useT();
+
+  const [savedAt, setSavedAt] = useState(0);
+
+  // form state
+  const [categories, setCategories] = useState<string[]>(kv.categories);
+  const [language, setLanguage] = useState(kv.language);
+  const [autocomplete, setAutocomplete] = useState(kv.autocomplete);
+  const [faviconResolver, setFaviconResolver] = useState(kv.favicon_resolver);
+  const [safesearch, setSafesearch] = useState(String(kv.safesearch));
+  const [tokens, setTokens] = useState(kv.tokens);
+  const [doiResolver, setDoiResolver] = useState(
+    Object.entries(data.doi_resolvers).find(([, url]) => url === kv.doi_resolver)?.[0] ?? "",
+  );
+  const [locale, setLocale] = useState(kv.locale);
+  const [theme, setTheme] = useState(kv.theme);
+  const [themeStyle, setThemeStyle] = useState<string>(kv.simple_style);
+  const [resultsOnNewTab, setResultsOnNewTab] = useState(kv.results_on_new_tab);
+  const [searchOnCategorySelect, setSearchOnCategorySelect] = useState(kv.search_on_category_select);
+  const [hotkeys, setHotkeys] = useState(kv.hotkeys);
+  const [urlFormatting, setUrlFormatting] = useState(kv.url_formatting);
+  const [method, setMethod] = useState<"GET" | "POST">(kv.method);
+  const [imageProxy, setImageProxy] = useState(kv.image_proxy);
+  const [queryInTitle, setQueryInTitle] = useState(kv.query_in_title);
+  const [centerAlignment, setCenterAlignment] = useState(kv.center_alignment);
+  const [engines, setEngines] = useState<Record<string, boolean>>(() => {
+    const map: Record<string, boolean> = {};
+    for (const tabInfo of data.engine_tabs) {
+      for (const group of tabInfo.groups) {
+        for (const engine of group.engines) {
+          map[`${engine.name}__${tabInfo.category}`] = !engine.disabled;
+        }
+      }
+    }
+    return map;
+  });
+  const [plugins, setPlugins] = useState<Record<string, boolean>>(() => {
+    const map: Record<string, boolean> = {};
+    for (const plugin of data.plugins) {
+      map[plugin.id] = plugin.enabled;
+    }
+    return map;
+  });
+  const [pastedHash, setPastedHash] = useState("");
+
+  const toggleEngine = (key: string, value: boolean) => {
+    setEngines((prev) => ({ ...prev, [key]: value }));
+  };
+  const setPluginEnabled = (id: string, enabled: boolean) => {
+    setPlugins((prev) => ({ ...prev, [id]: enabled }));
+  };
+  const setAllEngines = (keys: string[], value: boolean) => {
+    setEngines((prev) => {
+      const next = { ...prev };
+      for (const key of keys) {
+        next[key] = value;
+      }
+      return next;
+    });
+  };
+
+  // snapshot of every saved field, used to detect changes
+  const formSignature = JSON.stringify([
+    categories,
+    language,
+    autocomplete,
+    faviconResolver,
+    safesearch,
+    tokens,
+    doiResolver,
+    locale,
+    theme,
+    themeStyle,
+    hotkeys,
+    urlFormatting,
+    method,
+    imageProxy,
+    queryInTitle,
+    centerAlignment,
+    resultsOnNewTab,
+    searchOnCategorySelect,
+    engines,
+    plugins,
+    pastedHash,
+  ]);
+
+  const initialized = useRef(false);
+
+  // biome-ignore lint/correctness/useExhaustiveDependencies: formSignature covers all saved fields
+  useEffect(() => {
+    // skip the initial mount: nothing changed yet, posting would corrupt
+    // the reversed engine/plugin sets
+    if (!initialized.current) {
+      initialized.current = true;
+      return;
+    }
+    const timer = window.setTimeout(() => {
+      const fd = new FormData();
+      fd.set("language", language);
+      fd.set("autocomplete", autocomplete);
+      fd.set("favicon_resolver", faviconResolver);
+      fd.set("safesearch", safesearch);
+      fd.set("locale", locale);
+      fd.set("theme", theme);
+      fd.set("simple_style", themeStyle);
+      fd.set("hotkeys", hotkeys);
+      fd.set("url_formatting", urlFormatting);
+      fd.set("method", method);
+      fd.set("doi_resolver", doiResolver);
+      fd.set("tokens", tokens);
+      if (resultsOnNewTab) {
+        fd.set("results_on_new_tab", "on");
+      }
+      if (searchOnCategorySelect) {
+        fd.set("search_on_category_select", "on");
+      }
+      if (imageProxy) {
+        fd.set("image_proxy", "on");
+      }
+      if (queryInTitle) {
+        fd.set("query_in_title", "on");
+      }
+      if (centerAlignment) {
+        fd.set("center_alignment", "on");
+      }
+      for (const category of categories) {
+        fd.append(`category_${category}`, "on");
+      }
+      for (const [key, allowed] of Object.entries(engines)) {
+        if (!allowed) {
+          fd.set(`engine_${key.replaceAll(" ", "_")}`, "on");
+        }
+      }
+      for (const [id, enabled] of Object.entries(plugins)) {
+        if (!enabled) {
+          fd.set(`plugin_${id}`, "on");
+        }
+      }
+      if (pastedHash.trim()) {
+        fd.set("preferences", pastedHash.trim());
+      }
+      // fetchText throws on non-2xx, so "saved" only ever reports real
+      // successes; a failed POST leaves the state untouched and the next
+      // change re-fires the debounced save
+      void fetchText("/preferences", { body: fd, method: "POST", redirect: "follow" })
+        .then(() => {
+          setSavedAt(Date.now());
+        })
+        .catch(() => {
+          flashToast(t("save_failed"), { tone: "danger" });
+        });
+    }, 600);
+    return () => {
+      window.clearTimeout(timer);
+    };
+  }, [formSignature]);
+
+  return {
+    savedAt,
+    categories,
+    setCategories,
+    language,
+    setLanguage,
+    autocomplete,
+    setAutocomplete,
+    faviconResolver,
+    setFaviconResolver,
+    safesearch,
+    setSafesearch,
+    tokens,
+    setTokens,
+    doiResolver,
+    setDoiResolver,
+    locale,
+    setLocale,
+    theme,
+    setTheme,
+    themeStyle,
+    setThemeStyle,
+    resultsOnNewTab,
+    setResultsOnNewTab,
+    searchOnCategorySelect,
+    setSearchOnCategorySelect,
+    hotkeys,
+    setHotkeys,
+    urlFormatting,
+    setUrlFormatting,
+    method,
+    setMethod,
+    imageProxy,
+    setImageProxy,
+    queryInTitle,
+    setQueryInTitle,
+    centerAlignment,
+    setCenterAlignment,
+    engines,
+    toggleEngine,
+    setAllEngines,
+    plugins,
+    setPluginEnabled,
+    pastedHash,
+    setPastedHash,
+  };
+}
+
+export type PreferencesForm = ReturnType<typeof usePreferencesForm>;
diff --git a/client/zjsearch/src/styles/base.css b/client/zjsearch/src/styles/base.css
new file mode 100644
index 0000000..443672a
--- /dev/null
+++ b/client/zjsearch/src/styles/base.css
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: Apache-2.0 WITH Commons-Clause-1.0 */
+
+/* Element defaults plus .highlight — the query-highlight span the server-side
+   highlighter injects into result markup, global because any text renderer
+   can receive it. */
+
+@layer base {
+  html {
+    height: 100%;
+  }
+
+  body {
+    min-height: 100%;
+    background: var(--bg);
+    color: var(--ink);
+    font-family: var(--font-sans);
+    -webkit-font-smoothing: antialiased;
+    text-rendering: optimizeLegibility;
+  }
+
+  ::selection {
+    background: color-mix(in oklab, var(--accent) 26%, transparent);
+  }
+
+  :focus-visible {
+    outline: 2px solid var(--accent);
+    outline-offset: 2px;
+    border-radius: 4px;
+  }
+
+  button,
+  input,
+  select {
+    font: inherit;
+    color: inherit;
+  }
+
+  /* Tailwind v4 preflight no longer gives buttons the pointer cursor */
+  button {
+    cursor: pointer;
+  }
+
+  button:disabled {
+    cursor: default;
+  }
+}
+
+@layer components {
+  /* query highlight spans inserted by the server side highlighter */
+  .highlight {
+    background: var(--highlight-bg);
+    color: var(--ink);
+    border-radius: 3px;
+    padding: 0 1px;
+    box-decoration-break: clone;
+  }
+}
diff --git a/client/zjsearch/src/styles/behaviors.css b/client/zjsearch/src/styles/behaviors.css
new file mode 100644
index 0000000..c378c39
--- /dev/null
+++ b/client/zjsearch/src/styles/behaviors.css
@@ -0,0 +1,104 @@
+/* SPDX-License-Identifier: Apache-2.0 WITH Commons-Clause-1.0 */
+
+/* Document-level behaviors: the native details height animation, the global
+   reduced-motion guard, the results-width morph, the palette cross-fade with
+   its stand-down window, and the hero scroll lock.  These rules are
+   unlayered on purpose — keep this file after the layered partials. */
+
+/* Native <details> disclosures (sidebar boxes, dictionary definitions, help
+   sections) get the same height animation as the JS Collapse component where
+   the browser supports it (Chromium 131+; elsewhere the chevron rotation
+   alone marks the toggle — graceful degradation). */
+@supports selector(details::details-content) {
+  /* let block-size interpolate to `auto` (the details-open height) */
+  :root {
+    interpolate-size: allow-keywords;
+  }
+  details::details-content {
+    block-size: 0;
+    overflow: hidden;
+    transition:
+      block-size 0.3s cubic-bezier(0.22, 1, 0.36, 1),
+      content-visibility 0.3s allow-discrete;
+  }
+  details[open]::details-content {
+    block-size: auto;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  details::details-content {
+    transition-duration: 0.01ms !important;
+  }
+
+  *,
+  *::before,
+  *::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+    scroll-behavior: auto !important;
+  }
+}
+
+/* results width: wide by default (capped for readability), narrow + centered
+   when the center_alignment preference is on; the preference toggle morphs
+   the width instead of snapping (the global reduced-motion guard silences
+   the transition) */
+.zjs-results-main,
+.zjs-results-header-row {
+  max-width: var(--results-max, 90rem);
+  transition: max-width 0.3s cubic-bezier(0.22, 1, 0.36, 1);
+}
+
+/* palette cross-fade: the tokens registered above are <color> custom
+   properties, so flipping .dark / .black animates the variables on <html>
+   and the entire page follows with exactly one transition.  (An earlier
+   attempt put a transition window on every element — the per-frame
+   full-document recalc stuttered in patches on heavy pages.)  Browsers
+   without @property snap instantly; the global reduced-motion guard
+   (0.01ms !important on *) collapses the fade. */
+html {
+  transition:
+    --bg 0.3s ease,
+    --surface 0.3s ease,
+    --surface-2 0.3s ease,
+    --line 0.3s ease,
+    --ink 0.3s ease,
+    --ink-2 0.3s ease,
+    --ink-3 0.3s ease,
+    --accent 0.3s ease,
+    --accent-hover 0.3s ease,
+    --accent-strong 0.3s ease,
+    --accent-strong-hover 0.3s ease,
+    --accent-soft 0.3s ease,
+    --accent-contrast 0.3s ease,
+    --highlight-bg 0.3s ease,
+    --danger 0.3s ease,
+    --warning 0.3s ease,
+    --ok 0.3s ease;
+}
+
+/* stand-down window while the flip runs (applyThemeStyle adds the class for
+   ~350ms around a real palette change): elements with their own
+   transition-colors — chips, pills, switches — would chase the interpolating
+   tokens on their private 150ms timer and visibly lag the page (the
+   score/engine pills read out of sync).  With their transitions stood down
+   they track the variables directly, like everything else. */
+html.zjs-palette-anim *:not(html),
+html.zjs-palette-anim :not(html)::before,
+html.zjs-palette-anim :not(html)::after {
+  transition: none !important;
+}
+
+html.centered {
+  --results-max: 72rem;
+}
+
+/* hero shell (home page) owns its scrolling: the document never scrolls or
+   rubber-bands (iOS Safari would otherwise push the whole layout around);
+   all overflow lives in the shell's inner scroll container */
+.zjs-hero-lock {
+  overflow: hidden;
+  overscroll-behavior: none;
+}
diff --git a/client/zjsearch/src/styles/boot.css b/client/zjsearch/src/styles/boot.css
new file mode 100644
index 0000000..1c30d22
--- /dev/null
+++ b/client/zjsearch/src/styles/boot.css
@@ -0,0 +1,235 @@
+/* SPDX-License-Identifier: Apache-2.0 WITH Commons-Clause-1.0 */
+
+/* Skeleton family: the .zjs-skeleton shimmer primitive (shared by the
+   server-streamed shell and React's ResultSkeleton in cardParts.tsx) and the
+   .zjs-boot streamed boot skeleton (skeleton.html) with its error screen. */
+
+@layer components {
+  .zjs-skeleton {
+    position: relative;
+    overflow: hidden;
+    background: var(--surface-2);
+    border-radius: 8px;
+  }
+
+  .zjs-skeleton::after {
+    content: "";
+    position: absolute;
+    inset: 0;
+    background: linear-gradient(90deg, transparent, color-mix(in oklab, var(--surface) 65%, transparent), transparent);
+    animation: var(--animate-shimmer);
+  }
+
+  /* boot skeleton: streamed by the server before the search finishes
+     (results page shell), wiped by React on boot.  Geometry mirrors the real
+     results page — header row, category tabs, filter row, text cards, an
+     empty right rail — so the boot swap does not shift the layout; hidden
+     for no-JS via the inline <noscript><style> in the skeleton markup. */
+  .zjs-boot {
+    max-width: var(--results-max, 90rem);
+    margin-inline: auto;
+    padding: 0.75rem 1rem 2rem;
+  }
+  @media (min-width: 40rem) {
+    .zjs-boot {
+      padding-inline: 1.5rem;
+    }
+  }
+  .zjs-boot-top {
+    display: flex;
+    align-items: center;
+    gap: 1rem;
+  }
+  .zjs-boot-brand {
+    display: none;
+    flex: none;
+    font-size: 1.25rem;
+    font-weight: 800;
+    letter-spacing: -0.025em;
+    color: var(--ink);
+    white-space: nowrap;
+  }
+  .zjs-boot-brand span {
+    color: var(--accent);
+  }
+  /* stand-in for the real compact SearchBox: h-12 ps-5 pe-2 with the
+     max-w-2xl xl:max-w-3xl 2xl:max-w-4xl column of ResultsPage's header */
+  .zjs-boot-q {
+    flex: 1 1 auto;
+    display: flex;
+    align-items: center;
+    gap: 0.5rem;
+    min-width: 0;
+    max-width: 42rem;
+    padding: 0.375rem 0.5rem 0.375rem 1.25rem;
+    border: 1px solid var(--line);
+    border-radius: 9999px;
+    background: var(--surface);
+    box-shadow: var(--shadow-card);
+    color: var(--ink-2);
+    font-size: 1rem;
+  }
+  @media (min-width: 80rem) {
+    .zjs-boot-q {
+      max-width: 48rem;
+    }
+  }
+  @media (min-width: 96rem) {
+    .zjs-boot-q {
+      max-width: 56rem;
+    }
+  }
+  .zjs-boot-q-text {
+    flex: 1 1 auto;
+    min-width: 0;
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+  }
+  /* static stand-in for the accent submit button of the real search box */
+  .zjs-boot-submit {
+    flex: none;
+    display: grid;
+    place-items: center;
+    width: 2.25rem;
+    height: 2.25rem;
+    border-radius: 9999px;
+    background: var(--accent-strong);
+    color: var(--accent-contrast);
+  }
+  /* ghost HeaderActions: the 36px ghost circles of the real icon buttons */
+  .zjs-boot-actions {
+    flex: none;
+    display: flex;
+    align-items: center;
+    gap: 0.25rem;
+    margin-inline-start: auto;
+  }
+  .zjs-boot-action {
+    width: 2.25rem;
+    height: 2.25rem;
+    border-radius: 9999px;
+  }
+  .zjs-boot-body {
+    display: flex;
+    gap: 2rem;
+    margin-top: 1rem;
+  }
+  .zjs-boot-main {
+    flex: 1 1 0;
+    min-width: 0;
+  }
+  /* ghost category tabs (text + amber underline; first one selected) and
+     filter row (h-9 rounded-xl dropdown triggers) of the real page */
+  .zjs-boot-tabs {
+    display: flex;
+    align-items: center;
+    gap: 0.25rem;
+    overflow: hidden;
+    padding-block: 0.25rem;
+  }
+  .zjs-boot-tab {
+    flex: none;
+    width: 5rem;
+    height: 2.25rem;
+    border-radius: 0.5rem;
+  }
+  .zjs-boot-tab.is-selected {
+    width: 6rem;
+    box-shadow: inset 0 -2px 0 var(--accent-strong);
+  }
+  .zjs-boot-filters {
+    display: flex;
+    align-items: center;
+    gap: 0.25rem;
+    margin-top: 0.25rem;
+    overflow: hidden;
+  }
+  .zjs-boot-filter {
+    flex: none;
+    width: 7rem;
+    height: 2.25rem;
+    border-radius: 0.75rem;
+  }
+  /* card stack mirrors ResultSkeleton + the real list's space-y-1 */
+  .zjs-boot-cards {
+    display: flex;
+    flex-direction: column;
+    gap: 0.25rem;
+    margin-top: 0.5rem;
+  }
+  .zjs-boot-card {
+    border-radius: 1rem;
+    padding: 1rem;
+  }
+  /* bars follow the real card rhythm: url / mt-1 title / mt-1.5 snippet ×2
+     / mt-2 engines pill — same values as ResultSkeleton in cardParts.tsx */
+  .zjs-boot-w40 {
+    height: 16px;
+    width: 160px;
+  }
+  .zjs-boot-title {
+    height: 24px;
+    width: 75%;
+    margin-top: 4px;
+  }
+  .zjs-boot-line {
+    height: 22px;
+    width: 100%;
+    margin-top: 6px;
+  }
+  .zjs-boot-line2 {
+    height: 22px;
+    width: 83%;
+    margin-top: 6px;
+  }
+  .zjs-boot-pill {
+    height: 22px;
+    width: 112px;
+    margin-top: 8px;
+    border-radius: 9999px;
+  }
+  /* width-only reservation of the results right rail (lg:w-80 xl:w-96),
+      which the real page keeps even while it is empty */
+  .zjs-boot-side {
+    display: none;
+  }
+  @media (min-width: 30rem) {
+    .zjs-boot-brand {
+      display: block;
+    }
+  }
+  @media (min-width: 64rem) {
+    .zjs-boot-side {
+      display: block;
+      flex: 0 0 20rem;
+    }
+  }
+  @media (min-width: 80rem) {
+    .zjs-boot-side {
+      flex-basis: 24rem;
+    }
+  }
+
+  /* boot error: replacement screen when the streamed search reports a
+     failure as a boot payload (the app never renders for it) */
+  .zjs-boot-error {
+    display: flex;
+    min-height: 60dvh;
+    flex-direction: column;
+    align-items: center;
+    justify-content: center;
+    gap: 0.75rem;
+    text-align: center;
+  }
+  .zjs-boot-error p {
+    font-size: 0.875rem;
+    color: var(--ink-2);
+  }
+  .zjs-boot-error a {
+    font-size: 0.875rem;
+    color: var(--accent);
+    text-decoration: underline;
+    text-underline-offset: 2px;
+  }
+}
diff --git a/client/zjsearch/src/styles/global.css b/client/zjsearch/src/styles/global.css
new file mode 100644
index 0000000..dfbcf63
--- /dev/null
+++ b/client/zjsearch/src/styles/global.css
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: Apache-2.0 WITH Commons-Clause-1.0 */
+
+/* zjsearch design system: minimal, modern, light & dark.
+
+   Single CSS entry — everything ships as one zjsearch.min.css.  The split is
+   by consumer, not by page: component styling is Tailwind utilities in the
+   TSX; these partials hold only what utilities cannot reach (tokens, element
+   defaults, the server-rendered faces, third-party chrome).  Import order
+   mirrors the original cascade order — behaviors.css and map.css stay
+   unlayered on purpose, so they must come last. */
+@import "tailwindcss";
+
+@import "./tokens.css";
+@import "./base.css";
+@import "./noscript.css";
+@import "./boot.css";
+@import "./prose.css";
+@import "./behaviors.css";
+@import "./map.css";
+
+@custom-variant dark (&:where(.dark, .dark *));
diff --git a/client/zjsearch/src/styles/map.css b/client/zjsearch/src/styles/map.css
new file mode 100644
index 0000000..e8002b2
--- /dev/null
+++ b/client/zjsearch/src/styles/map.css
@@ -0,0 +1,66 @@
+/* SPDX-License-Identifier: Apache-2.0 WITH Commons-Clause-1.0 */
+
+/* OpenLayers map chrome — third-party widget DOM that utilities cannot
+   reach; scoped under the .zjs-map root the MapCard renders. */
+
+/* OpenLayers map chrome: zoom control themed to the dark map buttons */
+.zjs-map .ol-zoom {
+  top: 0.625rem;
+  left: 0.625rem;
+  /* kill OpenLayers' own container box — only the themed buttons remain */
+  background-color: transparent;
+  padding: 0;
+  border: none;
+  border-radius: 0;
+}
+.zjs-map .ol-zoom button {
+  width: 1.75rem;
+  height: 1.75rem;
+  font-size: 1.125rem;
+  font-weight: 600;
+  line-height: 1;
+  color: var(--ink-2);
+  background-color: var(--surface);
+  border: none;
+  border-radius: 0;
+  cursor: pointer;
+}
+.zjs-map .ol-zoom button:hover,
+.zjs-map .ol-zoom button:focus,
+.zjs-map .ol-zoom button:active {
+  background-color: var(--surface-2);
+  color: var(--accent);
+}
+.zjs-map .ol-zoom .ol-zoom-in {
+  border-radius: 0.5rem 0.5rem 0 0;
+}
+.zjs-map .ol-zoom .ol-zoom-out {
+  border-radius: 0 0 0.5rem 0.5rem;
+  border-top: 1px solid var(--line);
+}
+
+.zjs-map .ol-scale-line {
+  background: transparent;
+  border-radius: 0;
+  padding: 0;
+}
+.zjs-map .ol-scale-line-inner {
+  margin: 1px 0;
+  color: var(--ink-3);
+  border-color: var(--ink-3);
+}
+
+/* attribution rides bare: no chip, just muted text over the tiles */
+.zjs-map .ol-control.ol-attribution,
+.zjs-map .ol-attribution {
+  background: transparent;
+  border-radius: 0;
+}
+.zjs-map .ol-attribution a,
+.zjs-map .ol-attribution button {
+  color: var(--ink-3);
+}
+.zjs-map .ol-attribution a:hover,
+.zjs-map .ol-attribution button:hover {
+  color: var(--ink);
+}
diff --git a/client/zjsearch/src/styles/noscript.css b/client/zjsearch/src/styles/noscript.css
new file mode 100644
index 0000000..97f6bc2
--- /dev/null
+++ b/client/zjsearch/src/styles/noscript.css
@@ -0,0 +1,228 @@
+/* SPDX-License-Identifier: Apache-2.0 WITH Commons-Clause-1.0 */
+
+/* Basic no-JS face (noscript.html) — a self-contained document style, see
+   the .zjs-noscript block below. */
+
+@layer components {
+  /* basic no-JS mode (noscript.html): self-contained document styling in the
+     RSS feed's visual language — own palette incl. a prefers-color-scheme
+     dark override, independent of the app's class-based theming (there is no
+     JS to set the theme classes) */
+  .zjs-noscript {
+    --ns-bg: #faf9f6;
+    --ns-surface: #ffffff;
+    --ns-line: #e6e2d7;
+    --ns-ink: #201d17;
+    --ns-ink-2: #6b675c;
+    --ns-ink-3: #716c61;
+    --ns-accent: #8c6800;
+    --ns-accent-strong: #f5c84c;
+    box-sizing: border-box;
+    min-height: 100vh;
+    background: var(--ns-bg);
+    color: var(--ns-ink);
+    font-family: system-ui, -apple-system, sans-serif;
+    font-size: 16px;
+    line-height: 1.6;
+    overflow-wrap: anywhere;
+  }
+
+  @media (prefers-color-scheme: dark) {
+    .zjs-noscript {
+      --ns-bg: #1b1a18;
+      --ns-surface: #232120;
+      --ns-line: #38342f;
+      --ns-ink: #eceae4;
+      --ns-ink-2: #a8a399;
+      --ns-ink-3: #9b958a;
+      --ns-accent: #fec843;
+      --ns-accent-strong: #fec843;
+    }
+  }
+
+  .zjs-ns-wrap {
+    box-sizing: border-box;
+    max-width: 48rem;
+    margin: 0 auto;
+    padding: 0 1rem 3rem;
+  }
+
+  .zjs-ns-brand {
+    padding: 2rem 0 1.5rem;
+    border-bottom: 2px solid var(--ns-accent-strong);
+  }
+
+  .zjs-ns-wordmark {
+    font-size: 1.25rem;
+    font-weight: 800;
+    letter-spacing: -0.01em;
+  }
+
+  .zjs-ns-wordmark .dot {
+    color: var(--ns-accent);
+  }
+
+  /* media extras so the no-JS face carries the same information as the app:
+     image thumbnails, torrent size/health/magnet, video duration/author */
+  .zjs-ns-thumb {
+    display: block;
+    margin: 0.35rem 0;
+  }
+  .zjs-ns-thumb img {
+    display: block;
+    max-width: 100%;
+    max-height: 220px;
+    border-radius: 8px;
+  }
+  .zjs-ns-meta2 {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 0.3rem 0.9rem;
+    margin: 0.4rem 0 0;
+    font-size: 0.75rem;
+    color: var(--ns-ink-3);
+  }
+  .zjs-ns-meta2 a {
+    color: var(--ns-accent);
+  }
+
+  .zjs-noscript h1 {
+    font-size: 1.25rem;
+    font-weight: 600;
+    margin: 1.4rem 0 0.2rem;
+  }
+
+  .zjs-ns-meta {
+    font-size: 0.8rem;
+    color: var(--ns-ink-3);
+    margin-bottom: 1.1rem;
+  }
+
+  .zjs-ns-meta .count {
+    font-weight: 600;
+    color: var(--ns-ink-2);
+  }
+
+  .zjs-ns-form {
+    display: flex;
+    gap: 0.5rem;
+    margin: 1.4rem 0 1.1rem;
+  }
+
+  .zjs-ns-form input[type="text"] {
+    min-width: 0;
+    flex: 1;
+    padding: 0.5rem 0.75rem;
+    border: 1px solid var(--ns-line);
+    border-radius: 0.75rem;
+    background: var(--ns-surface);
+    color: var(--ns-ink);
+    font: inherit;
+  }
+
+  .zjs-ns-form button {
+    padding: 0.5rem 1rem;
+    border: 0;
+    border-radius: 0.75rem;
+    background: var(--ns-accent-strong);
+    color: #241d0e;
+    cursor: pointer;
+    font: inherit;
+  }
+
+  .zjs-ns-answer {
+    background: var(--ns-surface);
+    border: 1px solid var(--ns-line);
+    border-radius: 16px;
+    padding: 0.9rem 1rem;
+    margin: 0 0 0.7rem;
+  }
+
+  .zjs-ns-article {
+    background: var(--ns-surface);
+    border: 1px solid var(--ns-line);
+    border-radius: 16px;
+    padding: 0.9rem 1rem;
+    margin-bottom: 0.7rem;
+    transition: border-color 0.15s ease;
+  }
+
+  .zjs-ns-article:hover {
+    border-color: var(--ns-accent-strong);
+  }
+
+  .zjs-ns-host {
+    font-size: 0.75rem;
+    color: var(--ns-ink-3);
+    margin-bottom: 0.25rem;
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+  }
+
+  .zjs-ns-article h3 {
+    margin: 0 0 0.35rem;
+    font-size: 1rem;
+    font-weight: 500;
+    line-height: 1.35;
+  }
+
+  .zjs-ns-title-link {
+    color: var(--ns-ink);
+    text-decoration: none;
+  }
+
+  .zjs-ns-title-link:hover {
+    color: var(--ns-accent);
+    text-decoration: underline;
+    text-underline-offset: 2px;
+  }
+
+  .zjs-ns-article p {
+    margin: 0 0 0.45rem;
+    font-size: 0.85rem;
+    line-height: 1.5;
+    color: var(--ns-ink-2);
+    display: -webkit-box;
+    -webkit-line-clamp: 2;
+    -webkit-box-orient: vertical;
+    overflow: hidden;
+  }
+
+  .zjs-ns-article time {
+    font-size: 0.75rem;
+    color: var(--ns-ink-3);
+  }
+
+  .zjs-ns-list {
+    list-style: none;
+    margin: 0;
+    padding: 0;
+  }
+
+  .zjs-ns-note {
+    font-size: 0.85rem;
+    color: var(--ns-ink-2);
+  }
+
+  .zjs-ns-note a {
+    color: var(--ns-accent);
+  }
+
+  .zjs-ns-paging a {
+    margin-right: 0.5rem;
+  }
+
+  .zjs-ns-table {
+    border-collapse: collapse;
+    margin: 1rem 0;
+    width: 100%;
+  }
+
+  .zjs-ns-table th,
+  .zjs-ns-table td {
+    border: 1px solid var(--ns-line);
+    padding: 0.4rem 0.6rem;
+    text-align: left;
+  }
+}
diff --git a/client/zjsearch/src/styles/prose.css b/client/zjsearch/src/styles/prose.css
new file mode 100644
index 0000000..2a255ef
--- /dev/null
+++ b/client/zjsearch/src/styles/prose.css
@@ -0,0 +1,109 @@
+/* SPDX-License-Identifier: Apache-2.0 WITH Commons-Clause-1.0 */
+
+/* Markdown-rendered long-form content (info/about pages). */
+
+@layer components {
+  /* server-rendered info/about pages (markdown-generated HTML) */
+  .prose-basic {
+    line-height: 1.7;
+    font-size: 0.925rem;
+    color: var(--ink-2);
+  }
+
+  .prose-basic h1,
+  .prose-basic h2,
+  .prose-basic h3 {
+    color: var(--ink);
+    font-weight: 600;
+    margin: 1.6em 0 0.5em;
+    line-height: 1.3;
+  }
+
+  .prose-basic h1 {
+    font-size: 1.5rem;
+    margin-top: 0.2em;
+  }
+
+  .prose-basic h2 {
+    font-size: 1.2rem;
+  }
+
+  .prose-basic a {
+    color: var(--accent);
+    text-decoration: underline;
+    text-underline-offset: 2px;
+  }
+
+  .prose-basic ul,
+  .prose-basic ol {
+    margin: 0.8em 0;
+    padding-inline-start: 1.4em;
+    list-style: disc;
+  }
+
+  .prose-basic ol {
+    list-style: decimal;
+  }
+
+  .prose-basic li {
+    margin: 0.25em 0;
+  }
+
+  .prose-basic code {
+    font-family: var(--font-mono);
+    font-size: 0.85em;
+    background: var(--surface-2);
+    border-radius: 4px;
+    padding: 0.1em 0.35em;
+  }
+
+  .prose-basic pre {
+    background: var(--surface-2);
+    border: 1px solid var(--line);
+    border-radius: 12px;
+    padding: 0.9em 1.1em;
+    overflow-x: auto;
+    margin: 1em 0;
+  }
+
+  .prose-basic pre code {
+    background: none;
+    padding: 0;
+  }
+
+  .prose-basic table {
+    border-collapse: collapse;
+    margin: 1em 0;
+    width: 100%;
+  }
+
+  .prose-basic th,
+  .prose-basic td {
+    border: 1px solid var(--line);
+    padding: 0.4em 0.7em;
+    text-align: start;
+  }
+
+  .prose-basic th {
+    background: var(--surface-2);
+    color: var(--ink);
+  }
+
+  .prose-basic blockquote {
+    border-inline-start: 3px solid var(--accent);
+    padding-inline-start: 1em;
+    margin: 1em 0;
+    color: var(--ink-3);
+  }
+
+  .prose-basic hr {
+    border: none;
+    border-top: 1px solid var(--line);
+    margin: 2em 0;
+  }
+
+  .prose-basic img {
+    max-width: 100%;
+    border-radius: 8px;
+  }
+}
