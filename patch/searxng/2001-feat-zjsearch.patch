@@ -0,0 +1,561 @@
+{#- zjsearch theme: server → React data contract.
+
+Every macro in this file serializes a piece of the Jinja render context into
+JSON.  The React application (client/zjsearch) consumes the resulting payload
+(``#page-data``) and renders 100% of the UI.  Server-side filters
+(image_proxify, favicon_url, get_pretty_url, query highlighting) are applied
+here, so the client never sees raw third-party URLs and inherits all data
+pipeline features without any Python changes. -#}
+
+{# ---------------------------------------------------------------- strings #}
+
+{#- Localized UI strings, keyed for the React i18n helper. -#}
+
+{# ----------------------------------------------------------------- globals #}
+
+{#- Shared context for every page: brand, categories, locales, i18n, prefs. -#}
+{% macro globals(page) -%}
+{
+  "page": {{ page|tojson }},
+  "instance_name": {{ instance_name|tojson }},
+  "version": {{ searxng_version|tojson }},
+  "git_url": {{ searxng_git_url|tojson }},
+  "issue_url": {{ (get_setting('brand.issue_url') or '')|tojson }},
+  "donation_url": {{ (donation_url or '')|tojson }},
+  "enable_metrics": {{ enable_metrics|tojson }},
+  "public_instances_url": {{ (get_setting('brand.public_instances') or '')|tojson }},
+  "privacypolicy_url": {{ (get_setting('general.privacypolicy_url') or '')|tojson }},
+  "contact_url": {{ (get_setting('general.contact_url') or '')|tojson }},
+  "custom_links": [
+    {%- for title, link in get_setting('brand.custom.links').items() -%}
+    {"title": {{ _(title)|tojson }}, "url": {{ link|tojson }}}{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ],
+  "search_formats": {{ search_formats|tojson }},
+  "categories_as_tabs": {{ categories_as_tabs|tojson }},
+  "categories": {{ categories|tojson }},
+  "default_category": {{ DEFAULT_CATEGORY|tojson }},
+  "category_labels": {
+    {%- for c in categories_as_tabs -%}
+    {{ c|tojson }}: {{ _(c)|tojson }}{{ ", " if not loop.last }}
+    {%- endfor -%}
+  },
+  "locales": [
+    {%- for tag, name, country, english, flag in sxng_locales -%}
+    {"tag": {{ tag|tojson }}, "name": {{ name|tojson }}, "country": {{ country|tojson }}, "english": {{ english|tojson }}, "flag": {{ flag|tojson }}}{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ],
+  "language": {{ current_language|tojson }},
+  "safesearch": {{ safesearch|tojson }},
+  "method": {{ method|tojson }},
+  "theme": {{ theme|tojson }},
+  "theme_style": {{ (preferences.get_value('simple_style') or 'auto')|tojson }},
+  "search_on_category_select": {{ search_on_category_select|tojson }},
+  "results_on_new_tab": {{ results_on_new_tab|tojson }},
+  "url_formatting": {{ url_formatting|tojson }},
+  "favicon_resolver": {{ favicon_resolver|tojson }},
+  "doi_resolver": {{ doi_resolver|tojson }},
+  "cache_url": {{ (cache_url or '')|tojson }},
+  "locale": {{ locale_rfc5646|tojson }},
+  "about_url": {{ url_for('info', pagename='about')|tojson }},
+  "search_syntax_url": {{ url_for('info', pagename='search-syntax')|tojson }},
+  "rtl": {{ 'true' if rtl else 'false' }}
+}
+{%- endmacro %}
+
+{# ----------------------------------------------------------------- results #}
+
+{#- One search result.  Emits the union of all fields used by the 11 result
+    layouts; ``template`` tells the client which one to render. -#}
+{% macro _result_data(result) -%}
+{
+  {%- if result.parsed_url %}
+  "netloc": {{ (result.parsed_url.netloc or '')|tojson }},
+  "favicon": {{ (favicon_url(result.parsed_url.netloc) or '')|tojson }},
+  "pretty_url": {{ get_pretty_url(result.parsed_url)|tojson }},
+  {%- endif %}
+  {%- if result.publishedDate %}
+  "published_date": {{ result.publishedDate.isoformat()|tojson }},
+  {%- endif %}
+  {%- if result.length %}
+    {%- if result.length is string %}
+  "length_display": {{ result.length|tojson }},
+    {%- elif result.length is number %}
+  "length_seconds": {{ result.length }},
+    {%- else %}
+  "length_seconds": {{ result.length.total_seconds() }},
+    {%- endif %}
+  {%- endif %}
+  {%- if result.views %}"views": {{ result.views|tojson }},{% endif %}
+  {%- if result.score is number %}"score": {{ result.score }},{% endif %}
+  {%- if result.author %}"author": {{ result.author|striptags|tojson }},{% endif %}
+  {%- if result.metadata %}"metadata": {{ result.metadata|tojson }},{% endif %}
+  {%- if result.img_src %}"img_src": {{ (image_proxify(result.img_src) or '')|tojson }},{% endif %}
+  {%- if result.thumbnail %}"thumbnail": {{ (image_proxify(result.thumbnail) or '')|tojson }},{% endif %}
+  {%- if result.iframe_src %}"iframe_src": {{ result.iframe_src|tojson }},{% endif %}
+  {%- if result.audio_src %}"audio_src": {{ result.audio_src|tojson }},{% endif %}
+  {%- if result.open_group %}"open_group": true,{% endif %}
+  {%- if result.close_group %}"close_group": true,{% endif %}
+
+  {%- if result.template == 'images.html' %}
+  "thumbnail_src": {{ (image_proxify(result.thumbnail_src) if result.thumbnail_src else '')|tojson }},
+  "resolution": {{ (result.resolution or '')|tojson }},
+  "img_format": {{ (result.img_format or '')|tojson }},
+  "source": {{ (result.source or '')|tojson }},
+  "filesize": {{ (result.filesize or '')|tojson }},
+  "formats": [
+    {%- for ref in (result.formats or []) -%}
+    {"url": {{ ref.url|tojson }}, "label": {{ (ref.label or '')|tojson }}}{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ],
+  {%- elif result.template == 'torrent.html' %}
+    {%- if result.magnetlink %}"magnetlink": {{ result.magnetlink|tojson }},{% endif %}
+    {%- if result.torrentfile %}"torrentfile": {{ result.torrentfile|tojson }},{% endif %}
+    {%- if result.seed is defined %}"seed": {{ result.seed | int or 0 }},{% endif %}
+    {%- if result.leech is defined %}"leech": {{ result.leech | int or 0 }},{% endif %}
+    {%- if result.filesize %}"filesize": {{ result.filesize|tojson }},{% endif %}
+    {%- if result.files %}"files": {{ result.files | int or 0 }},{% endif %}
+  {%- elif result.template == 'map.html' %}
+    {%- if result.address %}
+    {%- set a = result.address %}
+    {%- set addr_fields = {
+      'name': a.get('name'),
+      'road': a.get('road'),
+      'house_number': a.get('house_number'),
+      'postcode': a.get('postcode'),
+      'locality': a.get('locality'),
+      'country': a.get('country'),
+      'country_code': a.get('country_code'),
+    } -%}
+    "address": {
+      {%- for k, v in addr_fields.items() if v -%}
+      {{ k|tojson }}: {{ v|tojson }}{{ ", " if not loop.last }}
+      {%- endfor -%}
+    },
+    {%- endif %}
+    {%- if result.links %}
+    "links": [
+      {%- for l in result.links -%}
+      {"label": {{ (l.get('label') or '')|tojson }}, "url": {{ (l.get('url') or '')|tojson }}}{{ ", " if not loop.last }}
+      {%- endfor -%}
+    ],
+    {%- endif %}
+    {%- if result.data %}
+    "data": [
+      {%- for d in result.data -%}
+      {"label": {{ (d.get('label') or '')|tojson }}, "value": {{ (d.get('value') or '')|tojson }}}{{ ", " if not loop.last }}
+      {%- endfor -%}
+    ],
+    {%- endif %}
+    {%- if result.boundingbox %}"boundingbox": {{ result.boundingbox|tojson }},{% endif %}
+    {%- if result.longitude %}"longitude": {{ result.longitude|tojson }},{% endif %}
+    {%- if result.latitude %}"latitude": {{ result.latitude|tojson }},{% endif %}
+    {%- if result.geojson %}"geojson": {{ result.geojson|tojson }},{% endif %}
+  {%- elif result.template == 'paper.html' %}
+    {%- if result.comments %}"comments": {{ result.comments|tojson }},{% endif %}
+    {%- if result.tags %}"tags": {{ result.tags|tojson }},{% endif %}
+    {%- if result.type %}"paper_type": {{ result.type|tojson }},{% endif %}
+    {%- if result.authors %}"authors": {{ result.authors|tojson }},{% endif %}
+    {%- if result.editor %}"editor": {{ result.editor|tojson }},{% endif %}
+    {%- if result.publisher %}"publisher": {{ result.publisher|tojson }},{% endif %}
+    {%- if result.journal %}"journal": {{ result.journal|tojson }},{% endif %}
+    {%- if result.volume %}"volume": {{ result.volume|tojson }},{% endif %}
+    {%- if result.number %}"number": {{ result.number|tojson }},{% endif %}
+    {%- if result.pages %}"pages": {{ result.pages|tojson }},{% endif %}
+    {%- if result.doi %}"doi": {{ result.doi|tojson }},{% endif %}
+    {%- if result.issn %}"issn": {{ result.issn|tojson }},{% endif %}
+    {%- if result.isbn %}"isbn": {{ result.isbn|tojson }},{% endif %}
+    {%- if result.pdf_url %}"pdf_url": {{ result.pdf_url|tojson }},{% endif %}
+    {%- if result.html_url %}"html_url": {{ result.html_url|tojson }},{% endif %}
+  {%- elif result.template == 'packages.html' %}
+    {%- if result.package_name %}"package_name": {{ result.package_name|tojson }},{% endif %}
+    {%- if result.version %}"version": {{ result.version|tojson }},{% endif %}
+    {%- if result.maintainer %}"maintainer": {{ result.maintainer|tojson }},{% endif %}
+    {%- if result.tags %}"tags": {{ result.tags|tojson }},{% endif %}
+    {%- if result.popularity %}"popularity": {{ result.popularity|tojson }},{% endif %}
+    {%- if result.license_name %}"license_name": {{ result.license_name|tojson }},{% endif %}
+    {%- if result.license_url %}"license_url": {{ result.license_url|tojson }},{% endif %}
+    {%- if result.homepage %}"homepage": {{ result.homepage|tojson }},{% endif %}
+    {%- if result.source_code_url %}"source_code_url": {{ result.source_code_url|tojson }},{% endif %}
+    {%- if result.links %}"project_links": {{ result.links|tojson }},{% endif %}
+  {%- elif result.template == 'code.html' %}
+    {%- if result.repository %}"repository": {{ result.repository|tojson }},{% endif %}
+    {%- if result.filename %}"filename": {{ result.filename|tojson }},{% endif %}
+    {%- if result.HTML is defined %}
+      {%- set code_html = result.HTML() if result.HTML is callable else result.HTML %}
+    "code_html": {{ (code_html or '')|tojson }},
+    {%- endif %}
+  {%- elif result.template == 'file.html' %}
+    {%- if result.abstract %}"abstract_html": {{ result.abstract|tojson }},{% endif %}
+    {%- if result.author %}"author": {{ result.author|tojson }},{% endif %}
+    {%- if result.filename %}"filename": {{ result.filename|tojson }},{% endif %}
+    {%- if result.size %}"size": {{ result.size|tojson }},{% endif %}
+    {%- if result.time %}"time": {{ result.time|tojson }},{% endif %}
+    {%- if result.mimetype %}"mimetype": {{ result.mimetype|tojson }},{% endif %}
+    {%- if result.embedded %}"embedded": {{ result.embedded|tojson }},{% endif %}
+    {%- if result.mtype %}"mtype": {{ result.mtype|tojson }},{% endif %}
+    {%- if result.subtype %}"subtype": {{ result.subtype|tojson }},{% endif %}
+  {%- elif result.template == 'keyvalue.html' %}
+    {%- if result.caption %}"caption": {{ result.caption|tojson }},{% endif %}
+    {%- if result.key_title %}"key_title": {{ result.key_title|tojson }},{% endif %}
+    {%- if result.value_title %}"value_title": {{ result.value_title|tojson }},{% endif %}
+    {%- if result.kvmap %}
+    "kvmap": {
+      {%- for k, v in result.kvmap.items() -%}
+      {{ k|tojson }}: {{ v|tojson }}{{ ", " if not loop.last }}
+      {%- endfor -%}
+    },
+    {%- endif %}
+  {%- elif result.template == 'products.html' %}
+    {%- if result.price %}"price": {{ result.price|tojson }},{% endif %}
+    {%- if result.shipping %}"shipping": {{ result.shipping|tojson }},{% endif %}
+    {%- if result.source_country %}"source_country": {{ result.source_country|tojson }},{% endif %}
+  {%- endif %}
+
+  "template": {{ (result.template or 'default.html')|replace('.html', '')|tojson }},
+  {%- if result.score %}"score": {{ result.score|round(3) }},{% endif %}
+  "url": {{ (result.url or '')|tojson }},
+  "title_html": {{ (result.title or '')|tojson }},
+  "title_text": {{ (result.title or '')|striptags|tojson }},
