+        preload="none"
+        src={src}
+      />
+    </div>
+  );
+}
+
+// -------------------------------------------------------------- card shells
+
+export interface CardProps {
+  result: ResultItem;
+  globals: GlobalData;
+  /** map-intent pages open the inline OSM map automatically (upstream simple behaviour) */
+  autoOpenMap?: boolean;
