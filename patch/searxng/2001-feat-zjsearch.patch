@@ -0,0 +1,260 @@
+/* SPDX-License-Identifier: Apache-2.0 WITH Commons-Clause-1.0 */
+
+/* Design tokens: the palette custom properties (light / dark / OLED black),
+   their <color> @property registrations, the Tailwind theme mapping and the
+   named keyframes. */
+
+/* Register the theme color tokens as <color> custom properties so a palette
+   flip (.dark / .black) interpolates the variables themselves on <html>
+   (see the html transition rule next to the results-width rule): one
+   transition drives the whole-page cross-fade, every var() consumer follows
+   frame by frame.  Browsers without @property fall back to an instant
+   snap.  initial-value mirrors the light palette. */
+@property --bg {
+  syntax: "<color>";
+  inherits: true;
+  initial-value: #faf9f6;
+}
+@property --surface {
+  syntax: "<color>";
+  inherits: true;
+  initial-value: #ffffff;
+}
+@property --surface-2 {
+  syntax: "<color>";
+  inherits: true;
+  initial-value: #f1efe8;
+}
+@property --line {
+  syntax: "<color>";
+  inherits: true;
+  initial-value: #e6e2d7;
+}
+@property --ink {
+  syntax: "<color>";
+  inherits: true;
+  initial-value: #201d17;
+}
+@property --ink-2 {
+  syntax: "<color>";
+  inherits: true;
+  initial-value: #6b675c;
+}
+@property --ink-3 {
+  syntax: "<color>";
+  inherits: true;
+  initial-value: #716c61;
+}
+@property --accent {
+  syntax: "<color>";
+  inherits: true;
+  initial-value: #8c6800;
+}
+@property --accent-hover {
+  syntax: "<color>";
+  inherits: true;
+  initial-value: #7a5c00;
+}
+@property --accent-strong {
+  syntax: "<color>";
+  inherits: true;
+  initial-value: #f5c84c;
+}
+@property --accent-strong-hover {
+  syntax: "<color>";
+  inherits: true;
+  initial-value: #eebd35;
+}
+@property --accent-soft {
+  syntax: "<color>";
+  inherits: true;
+  initial-value: #faf0cf;
+}
+@property --accent-contrast {
+  syntax: "<color>";
+  inherits: true;
+  initial-value: #241d0e;
+}
+@property --highlight-bg {
+  syntax: "<color>";
+  inherits: true;
+  initial-value: #fde68a;
+}
+@property --danger {
+  syntax: "<color>";
+  inherits: true;
+  initial-value: #dc2626;
+}
+@property --warning {
+  syntax: "<color>";
+  inherits: true;
+  initial-value: #b45309;
+}
+@property --ok {
+  syntax: "<color>";
+  inherits: true;
+  initial-value: #15803d;
+}
+
+/* Kagi-inspired warm palette: warm neutrals + amber accent. */
+:root {
+  --bg: #faf9f6;
+  --surface: #ffffff;
+  --surface-2: #f1efe8;
+  --line: #e6e2d7;
+  --ink: #201d17;
+  --ink-2: #6b675c;
+  /* muted tier: must keep 4.5:1 against every surface it sits on (worst case
+     surface-2 #f1efe8) */
+  --ink-3: #716c61;
+  /* text accent doubles as small-text colour (links, chips) — #8c6800 keeps
+     ≥4.5:1 on white / surface-2 / accent-soft, so light mode passes AA */
+  --accent: #8c6800;
+  --accent-hover: #7a5c00;
+  --accent-strong: #f5c84c;
+  --accent-strong-hover: #eebd35;
+  --accent-soft: #faf0cf;
+  --accent-contrast: #241d0e;
+  --highlight-bg: #fde68a;
+  --danger: #dc2626;
+  --warning: #b45309;
+  --ok: #15803d;
+  --shadow-card: 0 1px 2px rgb(32 29 23 / 0.05), 0 4px 16px rgb(32 29 23 / 0.05);
+  --shadow-pop: 0 4px 6px rgb(32 29 23 / 0.07), 0 12px 32px rgb(32 29 23 / 0.16);
+  color-scheme: light;
+}
+
+.dark {
+  --bg: #1b1a18;
+  --surface: #232120;
+  --surface-2: #2c2a27;
+  --line: #38342f;
+  --ink: #eceae4;
+  --ink-2: #a8a399;
+  --ink-3: #9b958a;
+  --accent: #fec843;
+  --accent-hover: #ffd76b;
+  --accent-strong: #fec843;
+  --accent-strong-hover: #ffd76b;
+  --accent-soft: #3a3320;
+  --accent-contrast: #241d0e;
+  --highlight-bg: #4a4020;
+  --danger: #f87171;
+  --warning: #fbbf24;
+  --ok: #4ade80;
+  --shadow-card: 0 1px 2px rgb(0 0 0 / 0.35), 0 4px 16px rgb(0 0 0 / 0.3);
+  --shadow-pop: 0 4px 6px rgb(0 0 0 / 0.45), 0 12px 32px rgb(0 0 0 / 0.55);
+  color-scheme: dark;
+}
+
+/* Black (OLED): even deeper surfaces, applied on top of .dark */
+.black {
+  --bg: #000000;
+  --surface: #0b0b0c;
+  --surface-2: #161617;
+  --line: #242426;
+  --ink: #ececec;
+  --ink-2: #9a9a9a;
+  --ink-3: #828282;
+  --accent-soft: #292413;
+  --highlight-bg: #3d3617;
+  --shadow-card: 0 1px 2px rgb(0 0 0 / 0.6), 0 4px 16px rgb(0 0 0 / 0.5);
+}
+
+@theme inline {
+  --color-bg: var(--bg);
+  --color-surface: var(--surface);
+  --color-surface-2: var(--surface-2);
+  --color-line: var(--line);
+  --color-ink: var(--ink);
+  --color-ink-2: var(--ink-2);
+  --color-ink-3: var(--ink-3);
+  --color-accent: var(--accent);
+  --color-accent-hover: var(--accent-hover);
+  --color-accent-strong: var(--accent-strong);
+  --color-accent-strong-hover: var(--accent-strong-hover);
+  --color-accent-soft: var(--accent-soft);
+  --color-accent-contrast: var(--accent-contrast);
+  --color-highlight: var(--highlight-bg);
+  --color-danger: var(--danger);
+  --color-warning: var(--warning);
+  --color-ok: var(--ok);
+
+  --shadow-card: var(--shadow-card);
+  --shadow-pop: var(--shadow-pop);
+
+  --font-sans:
+    ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "PingFang SC",
+    "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
+  --font-mono: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, monospace;
+
+  --animate-fade-up: fade-up 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
+  --animate-slide-in-right: slide-in-right 0.32s cubic-bezier(0.22, 1, 0.36, 1) both;
+  --animate-fade-in: fade-in 0.2s ease-out both;
+  --animate-shimmer: shimmer 1.6s linear infinite;
+  --animate-progress: progress 1.1s cubic-bezier(0.65, 0.05, 0.36, 1) infinite;
+  --animate-pulse-soft: pulse-soft 1.6s ease-in-out infinite;
+  --animate-spin-slow: spin 1.6s linear infinite;
+}
+
+@keyframes slide-in-right {
+  from {
+    transform: translateX(100%);
+  }
+  to {
+    transform: translateX(0);
+  }
+}
+
+@keyframes fade-up {
+  from {
+    opacity: 0;
+    transform: translateY(8px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+@keyframes fade-in {
+  from {
+    opacity: 0;
+  }
+  to {
+    opacity: 1;
+  }
+}
+
+@keyframes shimmer {
+  from {
+    transform: translateX(-100%);
+  }
+  to {
+    transform: translateX(100%);
+  }
+}
+
+@keyframes progress {
+  0% {
+    transform: translateX(-100%) scaleX(0.4);
+  }
+  50% {
+    transform: translateX(30vw) scaleX(0.6);
+  }
+  100% {
+    transform: translateX(100vw) scaleX(0.4);
+  }
+}
+
+@keyframes pulse-soft {
+  0%,
+  100% {
+    opacity: 1;
+    transform: scale(1);
+  }
+  50% {
+    opacity: 0.55;
+    transform: scale(0.94);
+  }
+}
