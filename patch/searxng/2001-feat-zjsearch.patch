+  "datetime_display": {{ data.datetime.l10n(locale=data.location, fmt='short')|tojson }},
+  "time": {{ data.datetime.l10n(locale=data.location, fmt='HH:mm')|tojson }},
+  "weekday": {{ data.datetime.l10n(locale=data.location, fmt='EEE')|tojson }},
+  "date_iso": {{ data.datetime.datetime.date().isoformat()|tojson }},
+  "hour": {{ data.datetime.datetime.hour }}{% endif %}
+  {%- if data.feels_like %}, "feels_like": {{ data.feels_like.l10n(locale=data.location, unit="°C")|tojson }}{% endif %}
+  {%- if data.wind_from %}, "wind": {{ data.wind_from.l10n(locale=data.location)|tojson }}{% endif %}
+  {%- if data.wind_speed %}, "wind_speed": {{ data.wind_speed.l10n(locale=data.location)|tojson }}{% endif %}
+  {%- if data.pressure %}, "pressure": {{ data.pressure.l10n(locale=data.location)|tojson }}{% endif %}
+  {%- if data.humidity %}, "humidity": {{ data.humidity.l10n(locale=data.location)|tojson }}{% endif %}
+}
+{%- endmacro %}
+
+{% macro _answer_data(answer) -%}
+{
+  "template": {{ (answer.template or 'answer/legacy.html')|tojson }}
+  {%- if answer.template == 'answer/translations.html' %}
+  , "engine": {{ (answer.engine or '')|tojson }}
+  , "url": {{ (answer.url or '')|tojson }}
+  , "translations": [
+    {%- for item in answer.translations -%}
+    {
+      "text": {{ item.text|tojson }},
+      "transliteration": {{ (item.transliteration or '')|tojson }},
+      "examples": {{ (item.examples or [])|tojson }},
+      "definitions": {{ (item.definitions or [])|tojson }},
+      "synonyms": {{ (item.synonyms or [])|tojson }}
+    }{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ]
+  {%- elif answer.template == 'answer/weather.html' %}
+  , "service": {{ (answer.service or '')|tojson }}
+  , "url": {{ (answer.url or '')|tojson }}
+  , "current": {{ _weather_item(answer.current, answer) }}
+  , "forecasts": [
+    {%- for f in answer.forecasts -%}
+    {{ _weather_item(f, answer) }}{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ]
+{%- else %}
+, "answer": {{ (answer.answer or '')|tojson }}
+, "url": {{ (answer.url or '')|tojson }}
+{%- if answer.data %}
+, "data": { {%- for key, value in answer.data.items() %}{{ key|tojson }}: {{ value|tojson }}{{ ", " if not loop.last }}{%- endfor -%} }{% endif %}
+{%- endif %}
+}
+{%- endmacro %}
+
+{#- Infobox with attributes / urls / related topics. -#}
+{% macro _infobox_data(infobox) -%}
+{
+  "title": {{ (infobox.infobox or '')|tojson }},
+  "content_html": {{ (infobox.content or '')|tojson }},
+  "img_src": {{ (image_proxify(infobox.img_src) if infobox.img_src else '')|tojson }}
+  {%- if infobox.attributes %}
+  , "attributes": [
+    {%- for a in infobox.attributes -%}
+    {
+      "label": {{ (a.get('label') or '')|tojson }},
+      "value": {{ (a.get('value') or '')|tojson }},
+      "image_src": {{ (image_proxify(a['image']['src']) if a.get('image') and a['image'].get('src') else '')|tojson }},
+      "image_alt": {{ (a['image'].get('alt', '') if a.get('image') else '')|tojson }}
+    }{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ]
+  {%- endif %}
+  {%- if infobox.urls %}
+  , "urls": [
+    {%- for u in infobox.urls -%}
+    {"title": {{ (u.get('title') or u.get('url') or '')|tojson }}, "url": {{ (u.get('url') or '')|tojson }}}{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ]
+  {%- endif %}
+  {%- if infobox.relatedTopics %}
+  , "related_topics": [
+    {%- for topic in infobox.relatedTopics -%}
+    {
+      "name": {{ (topic.get('name') or '')|tojson }},
+      "suggestions": {{ (topic.get('suggestions') or [])|tojson }}
+    }{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ]
+  {%- endif %}
+}
+{%- endmacro %}
+
+{# ------------------------------------------------------------- page blocks #}
+
+{% macro page_404() -%}
+{"globals": {{ globals('404') }}}
+{%- endmacro %}
+
+{% macro page_index(selected_categories) -%}
+{
+  "globals": {{ globals('index') }},
+  "selected_categories": {{ (selected_categories or [])|tojson }}
+}
+{%- endmacro %}
+
+{% macro page_results(results, q, selected_categories, pageno, time_range,
+                      suggestions, corrections, answers, infoboxes,
+                      engine_data, paging, unresponsive_engines, timings,
+                      max_response_time, timeout_limit, current_language,
+                      search_language, only_template) -%}
+{
+  "globals": {{ globals('results') }},
+  "q": {{ q|tojson }},
+  "selected_categories": {{ (selected_categories or [])|tojson }},
+  "pageno": {{ pageno }},
+  "time_range": {{ (time_range or '')|tojson }},
+  "suggestions": [
+    {%- for s in suggestions -%}
+    {"q": {{ s.url|tojson }}, "title": {{ s.title|tojson }}}{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ],
+  "corrections": [
+    {%- for c in corrections -%}
+    {"q": {{ c.url|tojson }}, "title": {{ c.title|tojson }}}{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ],
+  "answers": [
+    {%- for a in answers -%}
+    {{ _answer_data(a) }}{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ],
+  "infoboxes": [
+    {%- for infobox in infoboxes -%}
+    {{ _infobox_data(infobox) }}{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ],
+  "results": [
+    {%- for result in results -%}
+    {{ _result_data(result) }}{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ],
+  "engine_data": {{ (engine_data or {})|tojson }},
+  "paging": {{ 'true' if paging else 'false' }},
+  "unresponsive_engines": {{ (unresponsive_engines or [])|tojson }},
+  "timings": [
+    {%- for engine_name, response_time in (timings or []) -%}
+    {"name": {{ engine_name|tojson }}, "time": {{ response_time|round(3) }}}{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ],
+  "max_response_time": {{ (max_response_time|round(3) if max_response_time else 'null') }},
+  "timeout_limit": {{ (timeout_limit or '')|tojson }},
+  "current_language": {{ current_language|tojson }},
+  "search_language": {{ (search_language or '')|tojson }},
+  "only_template": {{ only_template|tojson }}
+}
+{%- endmacro %}
+
+{%- macro _engine_entry(engine, categ, disabled_engines, shortcuts, stats, reliabilities, supports) -%}
+{%- set about_website = engine.about.website if engine.about is defined else '' -%}
+{%- set about_wikidata = engine.about.wikidata_id if engine.about is defined else '' -%}
+{
+  "name": {{ engine.name|tojson }},
+  "shortcut": {{ (shortcuts.get(engine.name) or '')|tojson }},
+  "categories": {{ (engine.categories or [])|tojson }},
+  "language": {{ ((engine.language or '')|upper if engine.language else '')|tojson }},
+  "enable_http": {{ 'true' if engine.enable_http else 'false' }},
+  "weight": {{ engine.weight or 1.0 }},
+  "timeout": {{ engine.timeout or 0 }},
+  "website": {{ (about_website or '')|tojson }},
+  "wikidata_id": {{ (about_wikidata or '')|tojson }},
+  "disabled": {{ 'true' if (engine.name, categ) in disabled_engines else 'false' }},
+{%- set st = stats[engine.name] if engine.name in stats else none -%}
+{%- set rel = reliabilities[engine.name] if engine.name in reliabilities else none -%}
+  "stats_time": {{ 'null' if st is none or st['time'] is none else st['time'] }},
+  "stats_rate80": {{ 'null' if st is none or st['rate80'] is none else st['rate80'] }},
+  "stats_rate95": {{ 'null' if st is none or st['rate95'] is none else st['rate95'] }},
+  "stats_result_count": {{ (st['result_count'] or 0) if st is not none else 0 }},
+  "warn_timeout": {{ 'true' if (st is not none and st['warn_timeout']) else 'false' }},
+  "reliability": {{ 'null' if rel is none or rel['reliability'] is none else rel['reliability'] }},
+  "errors": {{ (reliabilities.get(engine.name, {}).get('errors', []) if engine.name in reliabilities else [])|tojson }},
+  "supports_safesearch": {{ 'true' if (engine.name in supports and supports[engine.name]['safesearch']) else 'false' }},
+  "supports_time_range": {{ 'true' if (engine.name in supports and supports[engine.name]['time_range_support']) else 'false' }}
+}
+{%- endmacro %}
+
+{% macro page_preferences(prefs, selected_categories, locales, current_locale,
+                          engines_by_category, stats, max_rate95,
+                          reliabilities, supports, answer_storage,
+                          disabled_engines, autocomplete_backends,
+                          favicon_resolver_names, shortcuts, themes,
+                          plugins_storage, current_doi_resolver,
+                          allowed_plugins, preferences_url_params,
+                          locked_preferences, doi_resolvers, cookies) -%}
+{
+  "globals": {{ globals('preferences') }},
+  "current_locale": {{ (current_locale or '')|tojson }},
+  "locales": {
+    {%- for locale_id, locale_name in locales|dictsort -%}
+    {{ locale_id|tojson }}: {{ locale_name|tojson }}{{ ", " if not loop.last }}
+    {%- endfor -%}
+  },
+  "kv": {
+    "categories": {{ (selected_categories or [])|tojson }},
+    "language": {{ prefs.get_value('language')|tojson }},
+    "locale": {{ (prefs.get_value('locale') or '')|tojson }},
+    "autocomplete": {{ (prefs.get_value('autocomplete') or '')|tojson }},
+    "favicon_resolver": {{ (prefs.get_value('favicon_resolver') or '')|tojson }},
+    "safesearch": {{ prefs.get_value('safesearch')|tojson }},
+    "theme": {{ prefs.get_value('theme')|tojson }},
+    "simple_style": {{ (prefs.get_value('simple_style') or 'auto')|tojson }},
+    "center_alignment": {{ 'true' if prefs.get_value('center_alignment') else 'false' }},
+    "results_on_new_tab": {{ 'true' if prefs.get_value('results_on_new_tab') else 'false' }},
+    "search_on_category_select": {{ 'true' if prefs.get_value('search_on_category_select') else 'false' }},
+    "hotkeys": {{ prefs.get_value('hotkeys')|tojson }},
+    "url_formatting": {{ prefs.get_value('url_formatting')|tojson }},
+    "method": {{ prefs.get_value('method')|tojson }},
+    "image_proxy": {{ 'true' if prefs.get_value('image_proxy') else 'false' }},
+    "query_in_title": {{ 'true' if prefs.get_value('query_in_title') else 'false' }},
+    "doi_resolver": {{ current_doi_resolver|tojson }},
+    "tokens": {{ prefs.tokens.get_value()|tojson }}
+  },
+  "max_rate95": {{ max_rate95 or 0 }},
+  "autocomplete_backends": {{ (autocomplete_backends|list)|tojson }},
+  "favicon_resolver_names": {{ (favicon_resolver_names|list)|tojson }},
+  "themes": {{ themes|tojson }},
+  "doi_resolvers": { {%- for name, url in doi_resolvers.items() -%}{{ name|tojson }}: {{ url|tojson }}{{ ", " if not loop.last }}{%- endfor -%} },
+  "locked_preferences": {{ (locked_preferences or [])|tojson }},
+  "preferences_url_params": {{ preferences_url_params|tojson }},
+  "cookies": [
+    {%- for name, value in cookies.items() -%}
+    {"name": {{ name|tojson }}, "value": {{ value|tojson }}}{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ],
+  "answerers": [
+    {%- for info in answer_storage -%}
+    {"keywords": {{ (info.keywords or [])|tojson }}, "name": {{ (info.name or '')|tojson }}, "description": {{ (info.description or '')|tojson }}, "examples": {{ (info.examples or [])|tojson }}, "plugin": false}{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ],
+  "plugins": [
+    {%- for plugin in plugins_storage -%}
+    {"id": {{ plugin.id|tojson }}, "name": {{ _(plugin.name)|tojson }}, "description": {{ _(plugin.description)|tojson }}, "section": {{ (plugin.preference_section or '')|tojson }}, "enabled": {{ 'true' if plugin.id in allowed_plugins else 'false' }}, "keywords": {{ ((plugin.keywords or []))|tojson }}, "examples": {{ ((plugin.examples or []))|tojson }}, "plugin": true}{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ],
+  "engine_tabs": [
+    {%- for categ in categories_as_tabs + [DEFAULT_CATEGORY] -%}
+    {
+      "category": {{ categ|tojson }},
+      "label": {{ _(categ)|tojson }},
+      "is_default": {{ 'true' if categ == DEFAULT_CATEGORY else 'false' }},
+      "groups": [
+        {%- for group, group_bang, group_engines in engines_by_category[categ] | group_engines_in_tab -%}
+        {
+          "group": {{ _(group)|tojson }},
+          "group_bang": {{ (group_bang or '')|tojson }},
+          "engines": [
+            {%- for engine in group_engines -%}
+            {%- if not engine.private -%}
+            {{ _engine_entry(engine, categ, disabled_engines, shortcuts, stats, reliabilities, supports) }}{{ ", " if not loop.last }}
+            {%- endif -%}
+            {%- endfor -%}
+          ]
+        }{{ ", " if not loop.last }}
+        {%- endfor -%}
+      ]
+    }{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ]
+}
+{%- endmacro %}
+
+{% macro page_stats(sort_order, selected_engine_name, engine_stats, engine_reliabilities) -%}
+{
+  "globals": {{ globals('stats') }},
+  "sort_order": {{ (sort_order or '')|tojson }},
+  "selected_engine_name": {{ (selected_engine_name or '')|tojson }},
+  "max_result_count": {{ engine_stats.get('max_result_count', 0) or 0 }},
+  "max_time": {{ engine_stats.get('max_time', 0) or 0 }},
+  "engines": [
+    {%- for s in engine_stats.get('time', []) -%}
+    {
+      "name": {{ s.name|tojson }},
+      "score": {{ (s.score if s.score is not none else 'null') }},
+      "score_per_result": {{ (s.score_per_result if s.score_per_result is not none else 'null') }},
+      "result_count": {{ (s.result_count if s.result_count is not none else 'null') }},
+      "total": {{ (s.total if s.total is not none else 'null') }},
+      "http": {{ (s.http if s.http is not none else 'null') }},
+      "processing": {{ (s.processing if s.processing is not none else 'null') }},
+      "total_p80": {{ (s.total_p80 if s.total_p80 is not none else 'null') }},
+      "http_p80": {{ (s.http_p80 if s.http_p80 is not none else 'null') }},
+      "processing_p80": {{ (s.processing_p80 if s.processing_p80 is not none else 'null') }},
+      "total_p95": {{ (s.total_p95 if s.total_p95 is not none else 'null') }},
+      "http_p95": {{ (s.http_p95 if s.http_p95 is not none else 'null') }},
+      "processing_p95": {{ (s.processing_p95 if s.processing_p95 is not none else 'null') }},
+      "reliability": {{ (engine_reliabilities.get(s.name, {}).get('reliability', 'null') if s.name in engine_reliabilities else 'null') }}
+    }{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ],
+  "errors": [
+    {%- if selected_engine_name -%}
+    {%- for error in engine_reliabilities[selected_engine_name].errors -%}
+    {
+      "secondary": {{ 'true' if error.secondary else 'false' }},
+      "exception_classname": {{ (error.exception_classname or '')|tojson }},
+      "log_message": {{ (error.log_message or '')|tojson }},
+      "percentage": {{ error.percentage or 0 }},
+      "log_parameters": {{ ((error.log_parameters or [])|list)|tojson }},
+      "filename": {{ (error.filename or '')|tojson }},
+      "line_no": {{ error.line_no or 0 }},
+      "function": {{ (error.function or '')|tojson }},
+      "code": {{ (error.code or '')|tojson }}
+    }{{ ", " if not loop.last }}
+    {%- endfor -%}
+    {%- endif -%}
+  ]
+}
+{%- endmacro %}
+
+{% macro page_info(all_pages, active_page, active_pagename) -%}
+{
+  "globals": {{ globals('info') }},
+  "active_pagename": {{ active_pagename|tojson }},
+  "active_title": {{ active_page.title|tojson }},
+  "active_html": {{ active_page.html|tojson }},
+  "pages": [
+    {%- for pagename, locale, page in all_pages -%}
+    {"pagename": {{ pagename|tojson }}, "locale": {{ locale|tojson }}, "title": {{ page.title|tojson }}}{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ]
+}
+{%- endmacro %}
