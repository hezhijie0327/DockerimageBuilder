+    {%- if result.authors %}"authors": {{ result.authors|tojson }},{% endif %}
+    {%- if result.editor %}"editor": {{ result.editor|tojson }},{% endif %}
+    {%- if result.publisher %}"publisher": {{ result.publisher|tojson }},{% endif %}
+    {%- if result.journal %}"journal": {{ result.journal|tojson }},{% endif %}
+    {%- if result.volume %}"volume": {{ result.volume|tojson }},{% endif %}
+    {%- if result.number %}"number": {{ result.number|tojson }},{% endif %}
+    {%- if result.pages %}"pages": {{ result.pages|tojson }},{% endif %}
+    {%- if result.doi %}"doi": {{ result.doi|tojson }},{% endif %}
+    {%- if result.issn %}"issn": {{ result.issn|tojson }},{% endif %}
+    {%- if result.isbn %}"isbn": {{ result.isbn|tojson }},{% endif %}
+    {%- if result.pdf_url %}"pdf_url": {{ result.pdf_url|tojson }},{% endif %}
+    {%- if result.html_url %}"html_url": {{ result.html_url|tojson }},{% endif %}
+  {%- elif result.template == 'packages.html' %}
+    {%- if result.package_name %}"package_name": {{ result.package_name|tojson }},{% endif %}
+    {%- if result.version %}"version": {{ result.version|tojson }},{% endif %}
+    {%- if result.maintainer %}"maintainer": {{ result.maintainer|tojson }},{% endif %}
+    {%- if result.tags %}"tags": {{ result.tags|tojson }},{% endif %}
+    {%- if result.popularity %}"popularity": {{ result.popularity|tojson }},{% endif %}
+    {%- if result.license_name %}"license_name": {{ result.license_name|tojson }},{% endif %}
+    {%- if result.license_url %}"license_url": {{ result.license_url|tojson }},{% endif %}
+    {%- if result.homepage %}"homepage": {{ result.homepage|tojson }},{% endif %}
+    {%- if result.source_code_url %}"source_code_url": {{ result.source_code_url|tojson }},{% endif %}
+    {%- if result.links %}"project_links": {{ result.links|tojson }},{% endif %}
+  {%- elif result.template == 'code.html' %}
+    {%- if result.repository %}"repository": {{ result.repository|tojson }},{% endif %}
+    {%- if result.filename %}"filename": {{ result.filename|tojson }},{% endif %}
+    {%- if result.HTML is defined %}
+      {%- set code_html = result.HTML() if result.HTML is callable else result.HTML %}
+    "code_html": {{ (code_html or '')|tojson }},
+    {%- endif %}
+  {%- elif result.template == 'file.html' %}
+    {%- if result.abstract %}"abstract_html": {{ result.abstract|tojson }},{% endif %}
+    {%- if result.author %}"author": {{ result.author|tojson }},{% endif %}
+    {%- if result.filename %}"filename": {{ result.filename|tojson }},{% endif %}
+    {%- if result.size %}"size": {{ result.size|tojson }},{% endif %}
+    {%- if result.time %}"time": {{ result.time|tojson }},{% endif %}
+    {%- if result.mimetype %}"mimetype": {{ result.mimetype|tojson }},{% endif %}
+    {%- if result.embedded %}"embedded": {{ result.embedded|tojson }},{% endif %}
+    {%- if result.mtype %}"mtype": {{ result.mtype|tojson }},{% endif %}
+    {%- if result.subtype %}"subtype": {{ result.subtype|tojson }},{% endif %}
+  {%- elif result.template == 'keyvalue.html' %}
+    {%- if result.caption %}"caption": {{ result.caption|tojson }},{% endif %}
+    {%- if result.key_title %}"key_title": {{ result.key_title|tojson }},{% endif %}
+    {%- if result.value_title %}"value_title": {{ result.value_title|tojson }},{% endif %}
+    {%- if result.kvmap %}
+    "kvmap": {
+      {%- for k, v in result.kvmap.items() -%}
+      {{ k|tojson }}: {{ v|tojson }}{{ ", " if not loop.last }}
+      {%- endfor -%}
+    },
+    {%- endif %}
+  {%- elif result.template == 'products.html' %}
+    {%- if result.price %}"price": {{ result.price|tojson }},{% endif %}
+    {%- if result.shipping %}"shipping": {{ result.shipping|tojson }},{% endif %}
+    {%- if result.source_country %}"source_country": {{ result.source_country|tojson }},{% endif %}
+  {%- endif %}
+
+  "template": {{ (result.template or 'default.html')|replace('.html', '')|tojson }},
+  {%- if result.score %}"score": {{ result.score|round(3) }},{% endif %}
+  "url": {{ (result.url or '')|tojson }},
+  "title_html": {{ (result.title or '')|tojson }},
+  "title_text": {{ (result.title or '')|striptags|tojson }},
+  "content_html": {{ (result.content or '')|tojson }},
+  "content_text": {{ (result.content or '')|striptags|tojson }},
+  "engines": {{ ((result.engines|sort|list) if result.engines else [])|tojson }},
+  "category": {{ (result.category or '')|tojson }},
+  "priority": {{ (result.priority or '')|tojson }}
+}
+{%- endmacro %}
+
+{#- Answers (legacy text, translations, weather). -#}
+{% macro _weather_item(data, answer) -%}
+{
+  "summary": {{ (data.summary or '')|tojson }},
+  "symbol": {{ (data.url or '')|tojson }},
+  "location_name": {{ data.location.name|tojson }},
+  "timezone": {{ data.location.timezone|tojson }},
+  "condition": {{ (data.condition or '')|tojson }},
+  "temp_c": {{ data.temperature.value("°C") }},
+  "temp_f": {{ data.temperature.value("°F") }}
+  {%- if data.datetime %},
+  "datetime_iso": {{ data.datetime.datetime.isoformat()|tojson }},
+  "date_iso": {{ data.datetime.datetime.date().isoformat()|tojson }},
+  "hour": {{ data.datetime.datetime.hour }}{% endif %}
+  {%- if data.feels_like %}, "feels_like": {{ data.feels_like.value("°C") }}{% endif %}
+  {%- if data.wind_from %}, "wind": {{ data.wind_from.value("Point")|tojson }}{% endif %}
+  {%- if data.wind_speed %}, "wind_speed": {{ data.wind_speed.value("km/h") }}{% endif %}
+  {%- if data.pressure %}, "pressure": {{ data.pressure.value("hPa") }}{% endif %}
+  {%- if data.humidity %}, "humidity": {{ data.humidity.value() }}{% endif %}
+}
+{%- endmacro %}
+
+{% macro _answer_data(answer) -%}
+{
+  "template": {{ (answer.template or 'answer/legacy.html')|tojson }}
+  {%- if answer.template == 'answer/translations.html' %}
+  , "engine": {{ (answer.engine or '')|tojson }}
+  , "url": {{ (answer.url or '')|tojson }}
+  , "translations": [
+    {%- for item in answer.translations -%}
+    {
+      "text": {{ item.text|tojson }},
+      "transliteration": {{ (item.transliteration or '')|tojson }},
+      "examples": {{ (item.examples or [])|tojson }},
+      "definitions": {{ (item.definitions or [])|tojson }},
+      "synonyms": {{ (item.synonyms or [])|tojson }}
+    }{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ]
+  {%- elif answer.template == 'answer/weather.html' %}
+  , "engine": {{ (answer.engine or '')|tojson }}
+  , "service": {{ (answer.service or '')|tojson }}
+  , "url": {{ (answer.url or '')|tojson }}
+  , "current": {{ _weather_item(answer.current, answer) }}
+  , "forecasts": [
+    {%- for f in answer.forecasts -%}
+    {{ _weather_item(f, answer) }}{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ]
+{%- else %}
+, "answer": {{ (answer.answer or '')|tojson }}
+, "engine": {{ (answer.engine or '')|tojson }}
+, "url": {{ (answer.url or '')|tojson }}
+{%- if answer.data %}
+, "data": { {%- for key, value in answer.data.items() %}{{ key|tojson }}: {{ value|tojson }}{{ ", " if not loop.last }}{%- endfor -%} }{% endif %}
+{%- endif %}
+}
+{%- endmacro %}
+
+{#- Infobox with attributes / urls / related topics. -#}
+{% macro _infobox_data(infobox) -%}
+{
+  "title": {{ (infobox.infobox or '')|tojson }},
+  "content_html": {{ (infobox.content or '')|tojson }},
+  "img_src": {{ (media_url(infobox.img_src) if infobox.img_src else '')|tojson }}
+  {%- if infobox.attributes %}
+  , "attributes": [
+    {%- for a in infobox.attributes -%}
+    {
+      "label": {{ (a.get('label') or '')|tojson }},
+      "value": {{ (a.get('value') or '')|tojson }},
+      "image_src": {{ (media_url(a['image']['src']) if a.get('image') and a['image'].get('src') else '')|tojson }},
+      "image_alt": {{ (a['image'].get('alt', '') if a.get('image') else '')|tojson }}
+    }{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ]
+  {%- endif %}
+  {%- if infobox.urls %}
+  , "urls": [
+    {%- for u in infobox.urls -%}
+    {"title": {{ (u.get('title') or u.get('url') or '')|tojson }}, "url": {{ (u.get('url') or '')|tojson }}}{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ]
+  {%- endif %}
+  {%- if infobox.relatedTopics %}
+  , "related_topics": [
+    {%- for topic in infobox.relatedTopics -%}
+    {
+      "name": {{ (topic.get('name') or '')|tojson }},
+      "suggestions": {{ (topic.get('suggestions') or [])|tojson }}
+    }{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ]
+  {%- endif %}
+}
+{%- endmacro %}
+
+{# ------------------------------------------------------------- page blocks #}
+
+{% macro page_404() -%}
+{"globals": {{ globals('404') }}}
+{%- endmacro %}
+
+{# boot payloads of the streamed search page: the HTTP status is already out
+   when the search finishes, so redirects and failures close the stream with
+   these payloads instead (the client boots into them, see main.tsx) #}
+{% macro page_redirect(url) -%}
+{"globals": {{ globals('redirect') }}, "url": {{ url|tojson }}}
+{%- endmacro %}
+
+{% macro page_error(message) -%}
+{"globals": {{ globals('error') }}, "message": {{ (message or '')|tojson }}}
+{%- endmacro %}
+
+{# first-stage payload of the streamed search page: the client boots into it
+   right away (interactive header + skeleton) while the engines run; the late
+   chunk of the same response replaces it through #page-data (RouterProvider
+   consumes the pushed payload, it never re-fetches) #}
+{% macro page_boot(q, selected_categories, pageno, time_range, current_language) -%}
+{"globals": {{ globals('results') }},"q": {{ q|tojson }},"selected_categories": {{ (selected_categories or [])|tojson }},"pageno": {{ pageno }},"time_range": {{ (time_range or '')|tojson }},"suggestions": [],"corrections": [],"answers": [],"infoboxes": [],"results": [],"engine_data": {},"paging": false,"unresponsive_engines": [],"timings": [],"max_response_time": null,"timeout_limit": "","current_language": {{ current_language|tojson }},"search_language": "","only_template": "","pending": true}
+{%- endmacro %}
+
+{% macro page_index(selected_categories) -%}
+{
+  "globals": {{ globals('index') }},
+  "selected_categories": {{ (selected_categories or [])|tojson }}
+}
+{%- endmacro %}
+
+{% macro page_results(results, q, selected_categories, pageno, time_range,
+                      suggestions, corrections, answers, infoboxes,
+                      engine_data, paging, unresponsive_engines, timings,
+                      max_response_time, timeout_limit, current_language,
+                      search_language, only_template) -%}
+{
+  "globals": {{ globals('results') }},
+  "q": {{ q|tojson }},
+  "selected_categories": {{ (selected_categories or [])|tojson }},
+  "pageno": {{ pageno }},
+  "time_range": {{ (time_range or '')|tojson }},
+  "suggestions": [
+    {%- for s in suggestions -%}
+    {"q": {{ s.url|tojson }}, "title": {{ s.title|tojson }}}{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ],
+  "corrections": [
+    {%- for c in corrections -%}
+    {"q": {{ c.url|tojson }}, "title": {{ c.title|tojson }}}{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ],
+  "answers": [
+    {%- for a in answers -%}
+    {{ _answer_data(a) }}{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ],
+  "infoboxes": [
+    {%- for infobox in infoboxes -%}
+    {{ _infobox_data(infobox) }}{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ],
+  "results": [
+    {%- for result in results -%}
+    {{ _result_data(result) }}{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ],
+  "engine_data": {{ (engine_data or {})|tojson }},
+  "paging": {{ 'true' if paging else 'false' }},
+  "unresponsive_engines": {{ (unresponsive_engines or [])|tojson }},
+  "timings": [
+    {%- for engine_name, response_time in (timings or []) -%}
+    {"name": {{ engine_name|tojson }}, "time": {{ response_time|round(3) }}}{{ ", " if not loop.last }}
+    {%- endfor -%}
+  ],
+  "max_response_time": {{ (max_response_time|round(3) if max_response_time else 'null') }},
+  "timeout_limit": {{ (timeout_limit or '')|tojson }},
+  "current_language": {{ current_language|tojson }},
+  "search_language": {{ (search_language or '')|tojson }},
+  "only_template": {{ only_template|tojson }}
+}
+{%- endmacro %}
+
+{%- macro _engine_entry(engine, categ, disabled_engines, shortcuts, stats, reliabilities, supports) -%}
+{%- set about_website = engine.about.website if engine.about is defined else '' -%}
+{%- set about_wikidata = engine.about.wikidata_id if engine.about is defined else '' -%}
+{
+  "name": {{ engine.name|tojson }},
+  "shortcut": {{ (shortcuts.get(engine.name) or '')|tojson }},
+  "categories": {{ (engine.categories or [])|tojson }},
+  "language": {{ ((engine.language or '')|upper if engine.language else '')|tojson }},
+  "enable_http": {{ 'true' if engine.enable_http else 'false' }},
+  "weight": {{ engine.weight or 1.0 }},
+  "timeout": {{ engine.timeout or 0 }},
+  "website": {{ (about_website or '')|tojson }},
+  "wikidata_id": {{ (about_wikidata or '')|tojson }},
+  "disabled": {{ 'true' if (engine.name, categ) in disabled_engines else 'false' }},
+{%- set st = stats[engine.name] if engine.name in stats else none -%}
+{%- set rel = reliabilities[engine.name] if engine.name in reliabilities else none -%}
+  "stats_time": {{ 'null' if st is none or st['time'] is none else st['time'] }},
+  "stats_rate80": {{ 'null' if st is none or st['rate80'] is none else st['rate80'] }},
+  "stats_rate95": {{ 'null' if st is none or st['rate95'] is none else st['rate95'] }},
+  "stats_result_count": {{ (st['result_count'] or 0) if st is not none else 0 }},
+  "warn_timeout": {{ 'true' if (st is not none and st['warn_timeout']) else 'false' }},
+  "reliability": {{ 'null' if rel is none or rel['reliability'] is none else rel['reliability'] }},
+  "errors": {{ (reliabilities.get(engine.name, {}).get('errors', []) if engine.name in reliabilities else [])|tojson }},
+  "supports_safesearch": {{ 'true' if (engine.name in supports and supports[engine.name]['safesearch']) else 'false' }},
+  "supports_time_range": {{ 'true' if (engine.name in supports and supports[engine.name]['time_range_support']) else 'false' }}
+}
+{%- endmacro %}
+
+{% macro page_preferences(prefs, selected_categories, locales, current_locale,
+                          engines_by_category, stats, max_rate95,
