diff --git a/client/zjsearch/package.json b/client/zjsearch/package.json
new file mode 100644
index 0000000..1ab9e71
--- /dev/null
+++ b/client/zjsearch/package.json
@@ -0,0 +1,50 @@
+{
+  "$schema": "https://json.schemastore.org/package.json",
+  "name": "@hezhijie0327/zjsearch",
+  "version": "0.1.0",
+  "private": true,
+  "license": "Apache 2.0 with Commons Clause v1.0",
+  "type": "module",
+  "scripts": {
+    "build": "vite build",
+    "dev": "vite",
+    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath client/zjsearch/.husky || true",
+    "ci": "npm run lint && npm run build",
+    "clean": "rm -Rf node_modules",
+    "fix": "biome check --write",
+    "lint": "npm run lint:biome && npm run lint:tsc",
+    "lint:biome": "biome check",
+    "lint:tsc": "tsc --noEmit"
+  },
+  "browserslist": [
+    "baseline 2022",
+    "not dead"
+  ],
+  "dependencies": {
+    "clsx": "^2.1.1",
+    "lucide-react": "^1.45.0",
+    "ol": "^10.10.0",
+    "react": "^19.2.4",
+    "react-dom": "^19.2.4"
+  },
+  "devDependencies": {
+    "@biomejs/biome": "2.5.11",
+    "@tailwindcss/vite": "^4.1.18",
+    "@types/node": "^26.4.0",
+    "@types/react": "^19.2.14",
+    "@types/react-dom": "^19.2.3",
+    "browserslist": "^4.28.8",
+    "browserslist-to-esbuild": "^2.1.1",
+    "husky": "^9.1.7",
+    "lint-staged": "^17.5.1",
+    "sharp": "~0.35.4",
+    "tailwindcss": "^4.1.18",
+    "typescript": "~5.9.3",
+    "vite": "^8.2.2"
+  },
+  "lint-staged": {
+    "*.{ts,tsx,css,json}": [
+      "biome check --write --no-errors-on-unmatched"
+    ]
+  }
+}
